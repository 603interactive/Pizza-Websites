<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ seo_title }}</title>
<meta name="description" content="{{ esc(seo_desc) }}">
<meta name="theme-color" content="#14110F">
<meta property="og:title" content="{{ esc(seo_title) }}"><meta property="og:description" content="{{ esc(seo_desc) }}"><meta property="og:type" content="restaurant.restaurant">
{% if preview %}<style>{{ css }}</style>{% else %}<link rel="stylesheet" href="assets/site.css"><script type="application/ld+json">{{ jsonld }}</script>{% endif %}
</head>
<body>
{% if preview %}<div class="ribbon"><span>{{ ribbon }}</span><button type="button" data-ribbon-x aria-label="Dismiss">×</button></div>{% endif %}
<a class="skip" href="#today">Skip to today's hours</a>
<header class="top">
  <a class="brand" href="#top" aria-label="{{ short }} home"><img src="{{ img('logo.png') }}" width="900" height="509" alt="Brookside Pizza and Tap Public House II"></a>
  <nav aria-label="Main"><a href="#today">Today</a><a href="#menu">Menu</a><a href="#story">Our story</a><a href="#tap">The Tap</a><a href="#visit">Visit</a></nav>
  <a class="btn btn-sm" href="tel:{{ loc.tel }}">Call {{ loc.phone }}</a>
</header>
<main id="top">

<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-copy">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span><span data-status>Checking hours…</span></p>
      <h1>Pizza till <em>nine.</em><br>The Tap till <em>midnight.</em></h1>
      <p class="sub">Two businesses, one door at 930 Laconia Road in Belmont. Dough made fresh on premises every day, slices until 3 PM, subs, dinners and a full bar.</p>
      <div class="cta"><a class="btn" href="tel:{{ loc.tel }}">Call to order · {{ loc.phone }}</a><a class="btn btn-ghost" href="#menu">See the menu</a></div>
      <p class="mini">Dine in · Takeout · Delivery to Belmont and surrounding towns · Full bar · Keno</p>
    </div>
    <figure class="hero-ph"><img src="{{ img('pizza-chicken.webp') }}" width="960" height="1200" alt="Pizza topped with chicken, green and red peppers and white cheese" fetchpriority="high"></figure>
  </div>
</section>

<section class="board-sec" id="today" aria-labelledby="today-h">
  <div class="wrap">
    <div class="board" id="board">
      <div class="board-head">
        <div><p class="kicker">Only on this site</p><h2 id="today-h">What's open <em>right now</em></h2>
        <p class="board-lede">The old site says everything is open 11 AM to midnight. It is not: the kitchen closes at 9 or 10, and the bar keeps going. Pick a day and see exactly what is on, hour by hour.</p></div>
        <div class="days" id="days" role="group" aria-label="Choose a day">{% for r in week %}<button type="button" data-d="{{ r.dow }}" aria-pressed="false"><span>{{ r.day[:3] }}</span></button>{% endfor %}</div>
      </div>
      <p class="now" id="now" aria-live="polite">Checking the clock…</p>
      <div class="dial" id="dial">
        <div class="axis" aria-hidden="true"></div>
        <div class="lane" data-lane="slices"><div class="lane-l"><b>Slices</b><span data-t="slices"></span></div><div class="track"><i class="bar"></i></div></div>
        <div class="lane" data-lane="kitchen"><div class="lane-l"><b>Kitchen &amp; dine-in</b><span data-t="kitchen"></span></div><div class="track"><i class="bar"></i></div></div>
        <div class="lane" data-lane="bar"><div class="lane-l"><b>The Tap bar</b><span data-t="bar"></span></div><div class="track"><i class="bar"></i></div></div>
        <div class="nowline" id="nowline" hidden><span>now</span></div>
      </div>
      <noscript><p class="mini">Restaurant: Mon–Thu and Sun 11 AM–9 PM, Fri–Sat 11 AM–10 PM. Slices until 3 PM daily. Bar open until midnight, 7 days.</p></noscript>
      <p class="board-fine">Restaurant hours and “slices until 3 PM” come from the shop's printed menu. The bar is listed as “open till midnight 7 days a week”; its opening time is not published, so it is shown fading in.</p>
    </div>
  </div>
</section>

<section class="menu sec" id="menu">
  <div class="wrap">
    <div class="sec-head"><p class="kicker">The whole menu</p><h2>Every price, <em>in one place.</em></h2>
    <p class="lede">Transcribed from the shop's current paper menu, which until now only existed as two phone photos. Please add 8.5% NH Meals Tax. Prices may change without notice.</p></div>
    <div class="m-grid">
      <div class="m-side"><label class="m-q"><span class="sr">Search the menu</span><input id="m-q" type="search" placeholder="Search: gyro, wings, ravioli…" autocomplete="off"></label>
        <div class="m-tabs" id="m-tabs" role="tablist" aria-label="Menu sections">{% for c in menu %}<button type="button" role="tab" id="mt{{ loop.index0 }}" aria-controls="mp{{ loop.index0 }}" data-t="{{ loop.index0 }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ c.cat }}</button>{% endfor %}</div></div>
      <div class="m-main">
        <p class="m-count" id="m-count" aria-live="polite"></p>
        {% for c in menu %}<section class="m-panel" id="mp{{ loop.index0 }}" role="tabpanel" aria-labelledby="mt{{ loop.index0 }}" data-p="{{ loop.index0 }}" {% if not loop.first %}hidden{% endif %}>
          <div class="m-ph">{% if c.img %}<img src="{{ img(c.img) }}" alt="" loading="lazy">{% endif %}<div><h3>{{ c.cat }}</h3>{% if c.note %}<p>{{ c.note }}</p>{% endif %}</div></div>
          {% if c.head|length > 1 %}<p class="m-cols" aria-hidden="true">{% for h in c.head %}<span>{{ h }}</span>{% endfor %}</p>{% endif %}
          <ul class="m-list">
          {% for it in c['items'] %}<li class="m-it" data-s="{{ esc((it.name ~ ' ' ~ it.desc)|lower) }}">
            <div class="m-n"><b>{{ it.name }}</b>{% if it.desc %}<span>{{ it.desc }}</span>{% endif %}</div>
            <div class="m-p">{% for p in it.prices %}{% if p is not none %}<span>{% if c.head|length > 1 %}<small>{{ c.head[loop.index0] }}</small>{% endif %}{{ money(p) }}</span>{% elif c.head|length > 1 %}<span class="na"><small>{{ c.head[loop.index0] }}</small>–</span>{% endif %}{% endfor %}</div></li>{% endfor %}
          </ul></section>{% endfor %}
        <p class="m-none" id="m-none" hidden>Nothing on the menu matches that. Try “chicken” or “cheese”.</p>
      </div>
    </div>
  </div>
</section>

<section class="kitchen sec" aria-label="Photos from the kitchen">
  <div class="wrap"><p class="kicker">From the kitchen</p>
  <div class="mosaic">
    <figure class="m1"><img src="{{ img('pizza-bbq.webp') }}" width="900" height="1200" alt="BBQ-drizzled chicken pizza with red onion" loading="lazy"></figure>
    <figure class="m2"><img src="{{ img('wings.webp') }}" width="1200" height="1041" alt="Wings in a checkered basket with celery and blue cheese" loading="lazy"></figure>
    <figure class="m3"><img src="{{ img('burger.webp') }}" width="1200" height="1089" alt="Burger and fries in a checkered basket with a pickle" loading="lazy"></figure>
    <figure class="m4"><img src="{{ img('steaktip-caesar.webp') }}" width="960" height="1200" alt="Steak tip Caesar salad with shaved parmesan" loading="lazy"></figure>
    <figure class="m5"><img src="{{ img('skins.webp') }}" width="1200" height="1124" alt="Baked potato skins with melted cheese and sour cream" loading="lazy"></figure>
    <figure class="m6"><img src="{{ img('pizza-spaghetti.webp') }}" width="1094" height="1200" alt="Pizza topped with spaghetti and sliced meatballs" loading="lazy"></figure>
  </div></div>
</section>

<section class="story sec" id="story">
  <div class="wrap story-in">
    <div class="story-h"><p class="kicker">Our story</p><h2>A Brooklyn girl, a Belmont pizza shop, <em>and the boys.</em></h2>
    <p class="lede">From the shop's own history, lightly tidied.</p></div>
    <ol class="tl">
      <li><b>1984</b><p>Christine, born and raised in Brooklyn, relocates to New Hampshire. Living in the Loudon and Canterbury area, she and her husband Frank meet Billy and Sandy, who have just opened the original Brookside Pizza.</p></li>
      <li><b>1999</b><p>Christine joins forces with the Lazos family and starts learning the business. A year later she moves to the Belmont location.</p></li>
      <li><b>2003</b><p>Offered a partnership, Christine jumps at it.</p></li>
      <li><b>2006</b><p>In April, Brookside Pizza II opens The Tap Public House.</p></li>
      <li><b>2009</b><p>In January a break in the sprinkler water main forces the business to close. It reopens in May, with thanks to customers, friends and crew.</p></li>
      <li><b>Today</b><p>Most days you'll find her sons Michael and David and the rest of the crew hustling out the good food Brookside is known for.</p></li>
    </ol>
    <aside class="comm"><h3>In the community</h3><p>Brookside backs the Belmont DARE program, the Belknap County Sportsmen's Club and TEAM FEED, and donated ballistic helmets to the Belmont Police Department.</p></aside>
  </div>
</section>

<section class="tap sec" id="tap">
  <div class="wrap">
    <div class="sec-head"><p class="kicker">Next door, same building</p><h2>The Tap <em>Public House</em></h2>
    <p class="lede">Full bar, open until midnight seven days a week, with Keno, a pool table and a deck out back. Bar line: <a href="tel:{{ loc.bar_tel }}">{{ loc.bar_phone }}</a>.</p></div>
    <div class="tap-grid">
      <figure class="t1"><img src="{{ img('bar.webp') }}" width="1200" height="1200" alt="The Tap's corner bar with stools, taps and holiday garland" loading="lazy"></figure>
      <figure class="t2"><img src="{{ img('patio.webp') }}" width="1200" height="1200" alt="New wooden deck with string lights, picnic tables and bar stools" loading="lazy"></figure>
      <figure class="t3"><img src="{{ img('pool.webp') }}" width="1121" height="1152" alt="Pool table under the Convoy Follows sign" loading="lazy"></figure>
      <figure class="t4"><img src="{{ img('patio-crowd.webp') }}" width="1200" height="900" alt="Friends sharing food and drinks on the covered patio" loading="lazy"></figure>
    </div>
    <div class="cater"><h3>Catering &amp; events</h3><p>“The freshest hot &amp; cold catering menu options in the Lakes Region,” with custom menu options and on-site bartending. Talk to Michael Campione at <a href="tel:{{ loc.tel }}">{{ loc.phone }}</a> or <a href="tel:{{ loc.tel2 }}">{{ loc.phone2 }}</a>.</p></div>
  </div>
</section>

<section class="visit sec" id="visit">
  <div class="wrap visit-in">
    <div><p class="kicker">Come in or call</p><h2>930 Laconia Road, Belmont</h2>
      <p class="addr">{{ loc.street }}<br>{{ loc.city }}, {{ loc.region }} {{ loc.postal }}</p>
      <ul class="phones"><li><span>Restaurant</span><a href="tel:{{ loc.tel }}">{{ loc.phone }}</a></li><li><span>Restaurant</span><a href="tel:{{ loc.tel2 }}">{{ loc.phone2 }}</a></li><li><span>Bar</span><a href="tel:{{ loc.bar_tel }}">{{ loc.bar_phone }}</a></li></ul>
      <div class="cta"><a class="btn" href="tel:{{ loc.tel }}">Call to order</a><a class="btn btn-ghost" href="{{ loc.maps }}" rel="noopener">Get directions</a></div>
      <p class="mini">No online ordering: call to place your order. We deliver to Belmont and surrounding towns. <a href="{{ social.facebook }}" rel="noopener">Facebook</a> · <a href="{{ social.instagram }}" rel="noopener">Instagram</a></p></div>
    <div class="hours"><p class="pl-head"><span class="dot" aria-hidden="true"></span><span data-status>Checking hours…</span></p>
      <table><caption class="sr">Restaurant and bar hours</caption><thead><tr><th scope="col">Day</th><th scope="col">Restaurant</th><th scope="col">Bar</th></tr></thead><tbody>{% for r in week %}<tr data-dow="{{ r.dow }}"><th scope="row">{{ r.day }}</th><td>{{ r.text }}</td><td>Until midnight</td></tr>{% endfor %}</tbody></table>
      <p class="mini">Slices available daily until 3 PM.</p></div>
  </div>
</section>
</main>
<footer class="foot"><div class="wrap"><img src="{{ img('logo.png') }}" width="900" height="509" alt="Brookside Pizza and Tap Public House II"><p>{{ loc.street }}, {{ loc.city }}, {{ loc.region }} {{ loc.postal }} · <a href="tel:{{ loc.tel }}">{{ loc.phone }}</a></p><p class="mini">© {{ year }} Brookside Pizza II &amp; The Tap Public House. Family owned in Belmont, NH.</p></div></footer>
<div class="dock"><a class="pri" href="tel:{{ loc.tel }}">Call to order</a><a href="#menu">Menu</a><a href="{{ loc.maps }}" rel="noopener">Directions</a></div>
<script>window.__HOURS__={{ hours_json }};window.__BRK__={{ brk_json }};</script>
{% if preview %}<script>{{ js }}</script>{% else %}<script src="assets/site.js" defer></script>{% endif %}
</body></html>
