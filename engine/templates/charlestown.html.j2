<section class="sundae sec" id="sundae">
  <div class="wrap">
    <div class="sec-head"><p class="kicker">Only on this site</p><h2>The Soft-Serve <em>Sundae Maker.</em></h2><p class="lede">Twenty-six flavors is a lot to decide at the window. Build yours here from the shop’s real flavor list, then tell us at the counter.</p></div>
    <div class="sm">
      <div class="sm-stage">
        <div class="sm-art" id="sm-art" role="img" aria-label="Preview of your creation"></div>
        <p class="sm-name" id="sm-name" aria-live="polite"></p>
        <div class="sm-act"><button type="button" class="btn btn-sm" id="sm-copy">Copy my order</button><button type="button" class="btn btn-ghost btn-sm" id="sm-rand">Surprise me</button></div>
        <p class="fine" id="sm-hint">Order at the counter or call {{ loc.phone }}. Ice cream isn’t sold through online ordering.</p>
      </div>
      <div class="sm-ctl">
        <fieldset><legend>1 · What are you in the mood for?</legend><div class="chips" id="sm-fmt"></div></fieldset>
        <fieldset id="sm-fl"><legend id="sm-fl-leg">2 · Pick flavors</legend><div class="chips" id="sm-flv"></div></fieldset>
        <fieldset id="sm-ex" hidden><legend id="sm-ex-leg">3 · Pick one</legend><div class="chips" id="sm-exv"></div></fieldset>
      </div>
    </div>
  </div>
</section>

<section class="menu sec" id="menu">
  <div class="wrap">
    <div class="sec-head"><p class="kicker">The menu</p><h2>Fresh dough. <em>Homemade sauce.</em></h2><p class="lede">Every item from the shop’s menu in one place. Tap a section or search.</p></div>
    <div class="m-bar"><label class="sr" for="m-q">Search the menu</label><input id="m-q" type="search" placeholder="Search: steak, lasagna, wings…" autocomplete="off"><span class="m-count" id="m-count" aria-live="polite"></span></div>
    <div class="m-tabs" role="tablist" aria-label="Menu section" id="m-tabs">{% for c in menu %}<button type="button" role="tab" aria-selected="{{ 'true' if loop.first else 'false' }}" data-t="{{ slugify(c.cat) }}"><svg class="ti" aria-hidden="true"><use href="#{{ icons.get(slugify(c.cat),'i-pizza') }}"/></svg>{{ c.cat }}</button>{% endfor %}<button type="button" role="tab" aria-selected="false" data-t="ice-cream"><svg class="ti" aria-hidden="true"><use href="#i-cream"/></svg>Ice Cream</button></div>
    {% for c in menu %}
    <section class="m-panel" data-p="{{ slugify(c.cat) }}" {% if not loop.first %}hidden{% endif %}>
      <h3><svg class="hi" aria-hidden="true"><use href="#{{ icons.get(slugify(c.cat),'i-pizza') }}"/></svg>{{ c.cat }}</h3>{% if c.note %}<p class="m-note">{{ c.note }}</p>{% endif %}
      <ul class="m-grid">
      {% for it in c['items'] %}
        <li class="card" data-t="{{ esc((c.cat ~ ' ' ~ it.name ~ ' ' ~ (it.desc or '')).lower()) }}"><b>{{ it.name }}</b>{% if it.desc %}<span class="d">{{ it.desc }}</span>{% endif %}
        <span class="pp">{% if it.sizes %}{% for s in it.sizes %}<i><em>{{ s[0] }}</em>{{ s[1] }}</i>{% endfor %}{% else %}<i class="one">{{ it.price }}</i>{% endif %}</span></li>
      {% endfor %}
      </ul>
    </section>
    {% endfor %}
    <section class="m-panel" data-p="ice-cream" hidden>
      <h3><svg class="hi" aria-hidden="true"><use href="#i-cream"/></svg>Ice Cream</h3><p class="m-note">{{ icecream.note }} Cones, waffle cones, dishes, sundaes, flurries, floats and shakes. Build one in the sundae maker above.</p>
      <div class="ic">
        <div class="card" data-t="ice cream cone dish flavors {{ icecream.scoops|join(' ')|lower }}"><b>Cone or dish flavors</b><span class="tags">{% for f in icecream.scoops %}<i>{{ f }}</i>{% endfor %}</span></div>
        <div class="card" data-t="ice cream flurries {{ icecream.flurries|join(' ')|lower }}"><b>Flurries</b><span class="tags">{% for f in icecream.flurries %}<i>{{ f }}</i>{% endfor %}</span></div>
        <div class="card" data-t="ice cream sundaes {{ icecream.sundaes|join(' ')|lower }}"><b>Sundaes</b><span class="tags">{% for f in icecream.sundaes %}<i>{{ f }}</i>{% endfor %}</span></div>
        <div class="card" data-t="ice cream floats {{ icecream.floats|join(' ')|lower }}"><b>Floats</b><span class="tags">{% for f in icecream.floats %}<i>{{ f }}</i>{% endfor %}</span></div>
        <div class="card wide" data-t="ice cream milkshakes {{ icecream.shakes|join(' ')|lower }}"><b>Milkshakes</b><span class="tags">{% for f in icecream.shakes %}<i>{{ f }}</i>{% endfor %}</span></div>
      </div>
    </section>
    <p class="fine">{{ menu_note }}</p>
    <p class="m-empty" id="m-empty" hidden>Nothing matches that. Try “chicken” or “shake”.</p>
  </div>
</section>

<section class="cater sec" id="catering">
  <div class="wrap cater-in">
    <div><p class="kicker">Catering</p><h2>Your pizza party <em>awaits.</em></h2><p class="lede">{{ catering }}</p><p class="fine">Prefer to talk? Call <a href="tel:{{ loc.tel }}">{{ loc.phone }}</a>.</p></div>
    <form class="cf" name="catering" method="POST" data-netlify="true" netlify-honeypot="bot-field" id="cf">
      <input type="hidden" name="form-name" value="catering"><p class="sr"><label>Leave this empty <input name="bot-field"></label></p>
      <label>Your name<input name="name" autocomplete="name" required></label>
      <label>Phone<input name="phone" type="tel" autocomplete="tel" required></label>
      <div class="two"><label>Event date<input name="date" type="date"></label><label>About how many people?<input name="headcount" type="number" min="1" inputmode="numeric"></label></div>
      <label>Tell us about it<textarea name="details" rows="3" placeholder="Pizza, subs, pasta, salads…"></textarea></label>
      <button class="btn" type="submit">Send inquiry</button><p class="cf-ok" id="cf-ok" hidden role="status">Thanks! We’ll get back to you soon.</p>
    </form>
  </div>
</section>

<section class="visit sec" id="visit">
  <div class="wrap v-grid">
    <div><p class="kicker">Visit</p><h2>Find us on <em>Main Street.</em></h2>
      <p class="addr">{{ loc.street }}<br>{{ loc.city }}, {{ loc.region }} {{ loc.postal }}</p>
      <p><a class="tel" href="tel:{{ loc.tel }}">{{ loc.phone }}</a></p>
      <p class="hrs"><b>Open 7 days a week</b><span>10:30 AM – 9:00 PM</span></p>
      <p class="fine">{{ about }}</p>
      <div class="cta"><a class="btn" href="{{ order_any }}" rel="noopener">Order online</a><a class="btn btn-ghost" href="{{ delivery }}" rel="noopener">DoorDash</a><a class="btn btn-ghost" href="{{ loc.maps }}" rel="noopener">Directions</a></div>
    </div>
    <div class="v-card"><h3>Hungry for work?</h3><p>We’re always happy to meet good people.</p><a class="btn btn-sm" href="{{ links.jobs }}" rel="noopener">Job application</a><div class="soc"><a href="{{ links.instagram }}" rel="noopener">Instagram @CHOPizza</a><a href="{{ links.facebook }}" rel="noopener">Facebook</a></div></div>
  </div>
</section>
</main>
<div class="checks" aria-hidden="true"></div>
<footer class="foot"><div class="wrap"><span>© {{ year }} {{ name }}. Family owned, Charlestown NH.</span><span>203 Main St · {{ loc.phone }}</span></div></footer>
<div class="dock"><a class="btn" href="{{ order_any }}" rel="noopener">Order</a><a class="btn btn-ghost" href="tel:{{ loc.tel }}">Call</a><a class="btn btn-ghost" href="#sundae">Sundae</a></div>
<script>window.__HOURS__={{ hours_json }};window.__IC={{ ic_json }};</script>
{% if preview %}<script>{{ js }}</script>{% else %}<script src="assets/site.js" defer></script>{% endif %}
</body>
</html>
