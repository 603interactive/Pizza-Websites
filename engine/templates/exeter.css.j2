:root{--red:#b01f17;--red-d:#8a1710;--blue:#6a98c9;--blue-l:#e3edf8;--navy:#14304e;--navy-d:#0b1f36;--paper:#fbf7ef;--ink:#1b2430;--mut:#55606e;--line:#d9d2c4;--r:14px}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:76px}
body{margin:0;background:var(--paper);color:var(--ink);font:400 17px/1.55 'Outfit',system-ui,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;height:auto;display:block}a{color:inherit}
h1,h2,h3{font-family:'Big Shoulders',Impact,sans-serif;font-weight:700;text-transform:uppercase;line-height:.95;letter-spacing:.01em;margin:0}
.sr{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.wrap{width:min(1180px,100% - 32px);margin-inline:auto}
:focus-visible{outline:3px solid var(--navy);outline-offset:3px;border-radius:4px}
.hero :focus-visible,.visit :focus-visible,.dock :focus-visible,.fab:focus-visible{outline-color:#fff}
.skip{position:absolute;left:12px;top:-60px;background:var(--navy);color:#fff;padding:10px 14px;z-index:99;border-radius:8px}.skip:focus{top:12px}
.ribbon{background:var(--navy);color:#fff;font-size:13px;padding:8px 44px 8px 16px;position:relative;text-align:center}
.ribbon button{position:absolute;right:8px;top:2px;background:none;border:0;color:#fff;font-size:24px;min-width:40px;min-height:40px;cursor:pointer}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 24px;border-radius:999px;background:var(--red);color:#fff;font:700 16px 'Outfit',sans-serif;text-decoration:none;border:2px solid var(--red);cursor:pointer;transition:transform .15s,background .15s}
.btn:hover{background:var(--red-d);border-color:var(--red-d);transform:translateY(-1px)}
.btn-ghost{background:transparent;color:var(--navy);border-color:var(--navy)}.btn-ghost:hover{background:var(--navy);color:#fff;border-color:var(--navy)}
.btn-sm{min-height:40px;padding:0 18px;font-size:15px}
.link{background:none;border:0;color:var(--navy);text-decoration:underline;font:inherit;cursor:pointer;min-height:44px;padding:0 6px}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin:22px 0 0}
.fine{font-size:14px;color:var(--mut);margin:14px 0 0}
.top{position:sticky;top:0;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 16px;background:#fff;border-bottom:5px solid;border-image:linear-gradient(90deg,var(--red) 50%,var(--blue) 50%) 1}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none}.brand img{border-radius:50%}
.bn{font:700 28px/.85 'Big Shoulders',sans-serif;text-transform:uppercase;color:var(--red);display:flex;flex-direction:column}
.bn small{font-size:13px;letter-spacing:.14em;color:#3e6c9f;margin-top:3px}
nav{display:flex;align-items:center;gap:22px}nav a{text-decoration:none;font-weight:700;font-size:15px}nav a:not(.btn):hover{color:var(--red)}
.burger{display:none;background:none;border:2px solid var(--navy);border-radius:10px;width:46px;height:46px;cursor:pointer;flex-direction:column;justify-content:center;align-items:center;gap:5px}
.burger i{width:22px;height:2px;background:var(--navy);display:block}
@media(max-width:860px){.burger{display:flex}nav{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;flex-direction:column;align-items:stretch;gap:0;padding:8px 16px 16px;border-bottom:1px solid var(--line);box-shadow:0 14px 24px #0002}nav.open{display:flex}nav a{padding:14px 4px;border-bottom:1px solid var(--line)}nav .btn{margin-top:12px;border-bottom:2px solid var(--red)}}
/* hero: split plate */
.hero{display:grid;grid-template-columns:1fr 1fr;position:relative;color:#fff;background:linear-gradient(90deg,var(--red) 50%,var(--blue) 50%)}
.hero .side{padding:56px clamp(20px,4vw,64px) 48px;display:flex;flex-direction:column;gap:14px;grid-row:1}
.side.pz{grid-column:1;align-items:flex-start}.side.sf{grid-column:2;align-items:flex-end;text-align:right;color:var(--navy-d)}
.big{font:700 clamp(76px,9.6vw,150px)/.8 'Big Shoulders',sans-serif;text-transform:uppercase;margin:0;letter-spacing:.01em}
.hp{margin:0;font-size:clamp(17px,1.5vw,21px);max-width:20ch;font-weight:700}
.seam{grid-column:1/-1;grid-row:1;place-self:center;width:min(21vw,290px);background:#fff;border-radius:28px;padding:10px;box-shadow:0 0 0 8px var(--paper),0 18px 40px #0004;z-index:2}
.seam img{width:100%;height:auto}
.hero-bar{grid-column:1/-1;grid-row:2;background:var(--paper);color:var(--ink);border-bottom:1px solid var(--line)}
.hb-in{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px 28px;padding:20px 0}
.hb-in .cta{margin:0}.hb-in .addr{margin:0;font-weight:700}
.pill{display:inline-flex;align-items:center;gap:10px;margin:0;font-weight:700;background:#fff;border:2px solid var(--line);border-radius:999px;padding:8px 16px}
.dot{width:12px;height:12px;border-radius:50%;background:#8a8f98;flex:none}.is-open .dot{background:#1f9d55;box-shadow:0 0 0 4px #1f9d5533}
@media(max-width:760px){
 .hero{grid-template-columns:1fr;background:linear-gradient(180deg,var(--red) 50%,var(--blue) 50%)}
 .hero .side{grid-column:1;padding:36px 20px}.side.pz{grid-row:1;padding-bottom:112px}.side.sf{grid-row:2;padding-top:112px;align-items:flex-start;text-align:left}
 .seam{grid-row:1/3;width:210px;padding:8px;border-radius:22px;box-shadow:0 0 0 6px var(--paper),0 14px 30px #0004}.hero-bar{grid-row:3}.big{font-size:clamp(84px,25vw,120px)}.hp{max-width:30ch}
 .hb-in{flex-direction:column;align-items:stretch}.hb-in .cta{flex-direction:column}.hb-in .btn{width:100%}.pill{align-self:flex-start}}
.quick{background:var(--navy);color:#fff;padding:0 0 12px}.quick .fine{color:#b9c7d8;margin:0 auto;padding-top:0}
.qgrid{display:grid;grid-template-columns:repeat(4,1fr)}
.qgrid a{display:flex;flex-direction:column;gap:2px;padding:20px 18px;text-decoration:none;border-left:1px solid #ffffff22}.qgrid a:first-child{border-left:0}
.qgrid a:hover{background:#ffffff12}.qgrid b{font:700 24px/1 'Big Shoulders',sans-serif;text-transform:uppercase;letter-spacing:.03em}.qgrid span{font-size:14px;color:#cfdbea}
.quick :focus-visible{outline-color:#fff}
@media(max-width:760px){.qgrid{grid-template-columns:1fr 1fr}.qgrid a:nth-child(3){border-left:0}.qgrid a:nth-child(n+3){border-top:1px solid #ffffff22}}
.sec{padding:84px 0}@media(max-width:760px){.sec{padding:56px 0}}
.kicker{margin:0 0 10px;font:400 13px 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--red)}
h2{font-size:clamp(40px,6vw,78px)}h2 em{font-style:normal;color:var(--red)}
.sec-head{max-width:760px;margin-bottom:34px}.lede{font-size:19px;color:#364150;margin:16px 0 0}
/* menu + tray */
.mcol{min-width:0}.mgrid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:36px;align-items:start}
.m-bar{position:sticky;top:64px;z-index:10;background:var(--paper);padding:10px 0 12px;border-bottom:2px solid var(--ink)}
.m-tabs{display:flex;gap:8px;overflow-x:auto;padding:2px 2px 8px;scrollbar-width:thin}
.m-tabs button{flex:none;min-height:42px;padding:0 16px;border-radius:999px;border:2px solid var(--ink);background:#fff;font:700 15px 'Outfit',sans-serif;cursor:pointer;white-space:nowrap}
.m-tabs button[aria-selected=true]{background:var(--red);color:#fff;border-color:var(--red)}
.m-q input{width:100%;min-height:46px;border:2px solid var(--ink);border-radius:10px;padding:0 14px;font:inherit;background:#fff;margin-top:4px}
.m-count{margin:12px 0 0;font-weight:700;min-height:1em}
.m-panel h3{font-size:46px;margin:26px 0 4px;color:var(--navy)}.m-note{margin:0 0 6px;color:var(--mut);font-size:15px}
.m-list{list-style:none;margin:0;padding:0}
.m-it{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px 16px;align-items:center;padding:14px 0;border-bottom:1px dashed #b9b09c}
.m-n b{display:block;font-size:18px}.m-n span{display:block;font-size:14.5px;color:var(--mut);margin-top:2px}
.m-p{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end}
.chip{min-height:44px;min-width:76px;padding:0 14px;border-radius:10px;border:2px solid var(--navy);background:#fff;color:var(--navy);font:400 15px 'DM Mono',monospace;cursor:pointer;display:inline-flex;align-items:center;gap:8px;justify-content:center;transition:background .12s,color .12s,transform .12s}
.chip small{font:700 12px 'Outfit',sans-serif;text-transform:uppercase;letter-spacing:.06em;color:var(--red)}
.chip:hover{background:var(--navy);color:#fff}.chip:hover small{color:#bcd3ee}.chip:active{transform:scale(.96)}
.chip.pop{background:var(--blue);border-color:var(--blue);color:var(--navy)}
.ask{font-size:14px;color:var(--mut);font-style:italic;max-width:16ch;text-align:right}
.m-none{font-weight:700}
@media(max-width:520px){.m-it{grid-template-columns:1fr}.m-p{justify-content:flex-start}.ask{text-align:left;max-width:none}}
.tray{position:sticky;top:84px;background:#fff;border:3px solid var(--navy);border-radius:var(--r);padding:20px;box-shadow:8px 8px 0 var(--blue)}
.tray-head{display:flex;justify-content:space-between;align-items:center}.tray h3{font-size:36px;color:var(--red)}.tray-x{display:none;background:none;border:2px solid var(--navy);border-radius:50%;width:44px;height:44px;font-size:26px;line-height:1;cursor:pointer}
.tray-empty{color:var(--mut);margin:10px 0 4px}
.tray-list{list-style:none;margin:10px 0 0;padding:0;max-height:42vh;overflow:auto}
.tray-list li{display:grid;grid-template-columns:1fr auto;gap:4px 10px;padding:10px 0;border-bottom:1px dashed #b9b09c;font-size:15px}
.tray-list .tn{font-weight:700;line-height:1.25}.tray-list .tn small{display:block;font-weight:400;color:var(--mut)}
.tray-list .tp{font:400 15px 'DM Mono',monospace;text-align:right}
.qty{grid-column:1/-1;display:flex;align-items:center;gap:6px}
.qty button{width:44px;height:44px;border-radius:50%;border:2px solid var(--navy);background:#fff;font-size:22px;line-height:1;cursor:pointer;color:var(--navy)}.qty button:hover{background:var(--navy);color:#fff}
.qty output{min-width:28px;text-align:center;font:700 16px 'Outfit'}
.tray-sum{margin:14px 0 0}.tray-sum div{display:flex;justify-content:space-between;gap:10px;align-items:baseline}.tray-sum dt{font-weight:700}.tray-sum dd{margin:0;font:400 28px 'DM Mono',monospace;color:var(--navy)}
.tray-sum .muted dt,.tray-sum .muted dd{font:400 14px 'Outfit';color:var(--mut)}
.tray-deals{margin-top:14px;background:var(--blue-l);border-left:5px solid var(--blue);padding:10px 12px;border-radius:6px;font-size:15px}.tray-deals p{margin:4px 0 0}
.tray-pts{font-size:14.5px;color:#364150;margin:12px 0 0}
.tray-act{display:flex;flex-direction:column;gap:10px;margin-top:16px}.tray-act .btn{width:100%}
.fab{display:none}
@media(max-width:1000px){
 .mgrid{grid-template-columns:minmax(0,1fr)}
 .tray{position:fixed;left:0;right:0;bottom:0;top:auto;z-index:60;border-radius:18px 18px 0 0;border-width:3px 0 0;box-shadow:0 -14px 40px #0005;max-height:84vh;overflow:auto;transform:translateY(110%);visibility:hidden;transition:transform .25s,visibility 0s .25s}
 .tray.open{transform:none;visibility:visible;transition:transform .25s}.tray-x{display:block}.tray-list{max-height:32vh}
 .fab{position:fixed;right:12px;bottom:72px;z-index:50;min-height:52px;padding:0 18px;border-radius:999px;background:var(--navy);color:#fff;border:2px solid #fff;font:700 16px 'Outfit';cursor:pointer;align-items:center;gap:10px;box-shadow:0 8px 24px #0006}
 .fab:not([hidden]){display:inline-flex}.fab b{background:var(--red);border-radius:999px;min-width:26px;height:26px;display:grid;place-items:center;font-size:14px}.fab i{font:400 15px 'DM Mono',monospace;font-style:normal}}
/* two kitchens */
.two{background:var(--blue-l)}
.two-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;border:3px solid var(--navy);border-radius:var(--r);overflow:hidden;background:#fff}
.card{padding:30px}.card h3{font-size:54px;margin-bottom:10px}
.card.cp{background:var(--red);color:#fff}.card.cs{background:var(--blue);color:var(--navy-d)}
.card ul{list-style:none;margin:0;padding:0}.card li{display:grid;grid-template-columns:1fr auto;gap:2px 14px;padding:14px 0;border-top:1px solid currentColor;border-top-color:#ffffff55}
.card.cs li{border-top-color:#14304e55}.card li b{font-size:20px}.card li span{grid-column:1;font-size:15px;opacity:.92}.card li i{grid-row:1;grid-column:2;font:400 16px 'DM Mono',monospace;font-style:normal;white-space:nowrap}
.card .fine{color:inherit;opacity:.9}
.two .cta{margin-top:26px}
@media(max-width:760px){.two-grid{grid-template-columns:1fr}.card{padding:22px}.card h3{font-size:46px}}
/* direct */
.direct{background:var(--navy);color:#fff}.direct h2 em{color:var(--blue)}.direct .kicker{color:#a6c6ea}.direct .lede{color:#e3ecf6}
.direct :focus-visible{outline-color:#fff}
.dir-in{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:start}
.by{font-size:14px;color:#a9bbd0;margin:10px 0 0}
.perks{list-style:none;margin:0;padding:0;display:grid;gap:14px}
.perks li{background:#ffffff12;border:1px solid #ffffff33;border-radius:var(--r);padding:18px 20px;display:grid;gap:2px}
.perks b{font:700 34px/1 'Big Shoulders',sans-serif;text-transform:uppercase;color:var(--blue)}.perks span{font-size:16px;color:#e3ecf6}
.about{margin-top:40px;border-top:1px solid #ffffff33;padding-top:28px}.about .lede.sm{font-size:19px;max-width:900px;margin:0}
@media(max-width:860px){.dir-in{grid-template-columns:1fr;gap:28px}}
/* visit */
.visit-in{display:grid;grid-template-columns:1fr 1fr;gap:48px}
.addr{font-size:19px;font-weight:700;margin:14px 0}.tel{font:700 40px 'Big Shoulders',sans-serif;color:var(--red);text-decoration:none;letter-spacing:.02em}
.hours{background:#fff;border:3px solid var(--navy);border-radius:var(--r);padding:22px}.pl-head{display:flex;align-items:center;gap:10px;font-weight:700;margin:0 0 10px}
.hours table{width:100%;border-collapse:collapse}.hours th,.hours td{padding:10px 4px;text-align:left;border-bottom:1px dashed #b9b09c;font-weight:400}.hours th{font-weight:700}.hours td{text-align:right;font-family:'DM Mono',monospace;font-size:15px}
.hours tr.today th,.hours tr.today td{color:var(--red);font-weight:700}
@media(max-width:860px){.visit-in{grid-template-columns:1fr;gap:28px}}
.foot{background:#0d2036;color:#cfdbea;padding:30px 0 100px;font-size:15px}.foot p{margin:0 0 6px}.foot a{color:#fff}.mini{color:#8ea3bb}
.dock{display:none}
@media(max-width:860px){.dock{display:grid;grid-template-columns:1fr 1.5fr 1fr;position:fixed;left:0;right:0;bottom:0;z-index:40;background:#fff;border-top:3px solid var(--navy)}.dock a{display:grid;place-items:center;min-height:56px;font-weight:700;text-decoration:none;color:var(--navy)}.dock .pri{background:var(--red);color:#fff}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}

.fine a{display:inline-block;padding:12px 0}
