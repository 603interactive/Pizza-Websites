<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ seo_title }}</title>
<meta name="description" content="{{ esc(seo_desc) }}">
<meta name="theme-color" content="#F4ECDA">
<meta property="og:title" content="{{ esc(seo_title) }}"><meta property="og:description" content="{{ esc(seo_desc) }}"><meta property="og:type" content="restaurant.restaurant">
{% if preview %}<style>{{ css }}</style>{% else %}<link rel="stylesheet" href="assets/site.css"><script type="application/ld+json">{{ jsonld }}</script>{% endif %}
</head>
<body>
{% if preview %}<div class="ribbon"><span>{{ ribbon }}</span><button type="button" data-ribbon-x aria-label="Dismiss">×</button></div>{% endif %}
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <a class="brand" href="#top" aria-label="Pelham House of Pizza home"><span class="mark" aria-hidden="true">P</span><span class="bn">Pelham<small>House of Pizza</small></span></a>
  <button class="burger" type="button" aria-expanded="false" aria-controls="nav"><span class="sr">Menu</span><i></i><i></i><i></i></button>
  <nav id="nav" aria-label="Main"><a href="#menu">Menu</a><a href="#photos">Photos</a><a href="#about">About</a><a href="#visit">Hours &amp; Directions</a><a class="btn btn-sm" href="{{ order_any }}" rel="noopener">Order online</a></nav>
</header>
<main id="main">
<section class="hero" id="top">
  <div class="hero-copy wrap">
    <p class="pill"><span class="dot" aria-hidden="true"></span><span data-status>Checking hours…</span></p>
    <h1>Pizza, subs &amp; dinners on <em>Bridge Street.</em></h1>
    <p class="sub">Pelham House of Pizza, {{ loc.street }}, {{ loc.city }}, {{ loc.region }}. Order online or call and we will have it ready.</p>
    <div class="cta"><a class="btn" href="{{ order_any }}" rel="noopener">Order online</a><a class="btn btn-ghost" href="tel:{{ loc.tel }}">Call {{ loc.phone }}</a></div>
  </div>
  <figure class="hero-ph"><img src="{{ img('pepperoni.webp') }}" width="1179" height="1572" alt="A pepperoni pizza with bubbly melted cheese on a wooden pizza peel" fetchpriority="high"></figure>
</section>

<section class="quick" aria-label="At a glance"><div class="wrap qgrid">
  <a href="{{ order_any }}" rel="noopener"><b>Order online</b><span>Pick up or delivery options</span></a>
  <a href="tel:{{ loc.tel }}"><b>Call</b><span>{{ loc.phone }}</span></a>
  <a href="{{ loc.maps }}" rel="noopener"><b>Directions</b><span>{{ loc.street }}, {{ loc.city }}</span></a>
  <a href="#visit"><b>Today</b><span data-today>See hours</span></a>
</div></section>

<section class="menu sec" id="menu">
  <div class="wrap">
    <div class="sec-head"><p class="kicker">The menu</p><h2>Straight off the <em>menu board</em></h2>
    <p class="lede">Styled after the screens above the counter. Tap a heading, or search for what you want.</p></div>
    <div class="board">
    <div class="m-bar"><div class="m-tabs" id="m-tabs" role="tablist" aria-label="Menu sections">{% for c in menu %}<button type="button" role="tab" id="mt{{ loop.index0 }}" aria-controls="mp{{ loop.index0 }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ c.cat }}</button>{% endfor %}</div>
      <label class="m-q"><span class="sr">Search the menu</span><input id="m-q" type="search" placeholder="Search: steak, salad, haddock…" autocomplete="off"></label></div>
    <p class="m-count" id="m-count" aria-live="polite"></p>
    {% for c in menu %}<section class="m-panel" id="mp{{ loop.index0 }}" role="tabpanel" aria-labelledby="mt{{ loop.index0 }}" {% if not loop.first %}hidden{% endif %}>
      <h3>{{ c.cat }}</h3>{% if c.note %}<p class="m-note">{{ c.note }}</p>{% endif %}
      {% if c.head|length > 1 %}<p class="m-cols" aria-hidden="true">{% for h in c.head %}<span>{{ h }}</span>{% endfor %}</p>{% endif %}
      <ul class="m-list">{% for it in c['items'] %}<li class="m-it" data-s="{{ esc((it.name ~ ' ' ~ it.desc)|lower) }}">
        <div class="m-n"><b>{{ it.name }}</b>{% if it.desc %}<span>{{ it.desc }}</span>{% endif %}</div>
        <div class="m-p">{% for p in it.prices %}<span>{% if c.head|length > 1 %}<small>{{ c.head[loop.index0] }}</small>{% endif %}{{ money(p) }}</span>{% else %}<span class="ask">Call for price</span>{% endfor %}</div></li>{% endfor %}</ul></section>{% endfor %}
    <p class="m-none" id="m-none" hidden>Nothing on the menu matches that. Try "chicken" or "steak".</p>
    </div>
    <p class="fine">This is a partial menu. Pizza toppings, specialty pizzas, subs, wings and more are on the full online menu; prices shown are from public listings and may have changed, so check when you order.</p>
    <div class="cta"><a class="btn" href="{{ order_any }}" rel="noopener">See the full menu &amp; order</a></div>
  </div>
</section>

<section class="photos sec" id="photos" aria-labelledby="ph-h">
  <div class="wrap">
    <div class="sec-head"><p class="kicker">From the kitchen</p><h2 id="ph-h">Fresh out of the <em>oven</em></h2></div>
    <div class="reel">
      <figure><img src="{{ img('pizza-chicken-bacon.webp') }}" width="1200" height="1600" alt="Pizza topped with chicken, mushrooms, bacon and diced tomato" loading="lazy"></figure>
      <figure><img src="{{ img('pizza-spinach.webp') }}" width="1179" height="1572" alt="Pizza with spinach, ham, mushrooms and bacon on a wooden peel" loading="lazy"></figure>
      <figure><img src="{{ img('pizza-broccoli-chicken.webp') }}" width="1179" height="1572" alt="Close-up of a pizza with chicken and broccoli on a white sauce" loading="lazy"></figure>
      <figure><img src="{{ img('chicken-salad.webp') }}" width="1200" height="1600" alt="A grilled chicken salad in a take-out container with dressing on the side" loading="lazy"></figure>
    </div>
  </div>
</section>

<section class="about sec" id="about">
  <div class="wrap about-in">
    <figure class="a-a"><img src="{{ img('dining-room.webp') }}" width="1600" height="1200" alt="The dining room with dark wood tables, black chairs and a window onto the street" loading="lazy"></figure>
    <div class="a-t"><p class="kicker">About us</p><h2>Dine in, take out, <em>order ahead</em></h2>
    <p class="lede">"Pelham House of Pizza is dedicated to serving authentic and flavorful pizzas that keep our customers coming back for more. Our commitment to quality sets us apart."</p>
    <p class="lede sm">Order through our website or delivery apps, or just stop in and read the board.</p></div>
    <figure class="a-b"><img src="{{ img('menu-boards.webp') }}" width="1200" height="1600" alt="Digital menu boards above the counter, with a soup of the day chalkboard and baked goods on the marble counter" loading="lazy"><figcaption>The menu boards and counter</figcaption></figure>
  </div>
</section>

<section class="visit sec" id="visit">
  <div class="wrap visit-in">
    <div><p class="kicker">Come in or call</p><h2>30 Bridge Street, <em>Pelham</em></h2>
      <p class="addr">{{ loc.street }}<br>{{ loc.city }}, {{ loc.region }} {{ loc.postal }}</p>
      <p><a class="tel" href="tel:{{ loc.tel }}">{{ loc.phone }}</a></p>
      <div class="cta"><a class="btn" href="{{ order_any }}" rel="noopener">Order online</a><a class="btn btn-ghost" href="{{ loc.maps }}" rel="noopener">Get directions</a></div>
      <p class="fine"><a href="{{ facebook }}" rel="noopener">Pelham House of Pizza on Facebook</a></p></div>
    <div class="hours" aria-label="Hours"><p class="pl-head"><span class="dot" aria-hidden="true"></span><span data-status>Checking hours…</span></p>
      <table><tbody>{% for r in week %}<tr data-dow="{{ r.dow }}"><th scope="row">{{ r.day }}</th><td>{{ r.text }}</td></tr>{% endfor %}</tbody></table>
      <p class="fine">Hours are from a public listing; call to confirm, especially on holidays.</p></div>
  </div>
</section>
</main>
<footer class="foot"><div class="wrap"><p><b>Pelham House of Pizza</b> · {{ loc.street }}, {{ loc.city }}, {{ loc.region }} {{ loc.postal }} · <a href="tel:{{ loc.tel }}">{{ loc.phone }}</a></p><p class="mini">© {{ year }} Pelham House of Pizza.</p></div></footer>
<div class="dock"><a href="tel:{{ loc.tel }}">Call</a><a class="pri" href="{{ order_any }}" rel="noopener">Order online</a><a href="{{ loc.maps }}" rel="noopener">Directions</a></div>
<script>window.__HOURS__={{ hours_json }};</script>
{% if preview %}<script>{{ js }}</script>{% else %}<script src="assets/site.js" defer></script>{% endif %}
</body></html>
