:root{--teal:#0E5A60;--teal2:#0A4448;--teal3:#127880;--ink:#101616;--gold:#F2C84B;--gold2:#FBE9A8;--gold-d:#7A5A00;--cream:#FFF9E8;--paper:#FFFDF6;--red:#D2232A;--red2:#A91A20;--mut:#46524F;--line:#E4D9B8;--ok:#1E8A4C;--fd:"Big Shoulders",Impact,"Arial Narrow",sans-serif;--fb:"Instrument Sans",system-ui,-apple-system,"Segoe UI",sans-serif;--fm:"DM Mono",ui-monospace,Menlo,monospace}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--cream);color:var(--ink);font:400 1rem/1.6 var(--fb);-webkit-font-smoothing:antialiased;padding-bottom:68px;overflow-x:hidden}
img{max-width:100%;height:auto;display:block}a{color:inherit}
h1,h2,h3{font-family:var(--fd);font-weight:700;line-height:.98;margin:0;text-transform:uppercase;letter-spacing:.01em}
h1{font-size:clamp(3rem,9.2vw,6.4rem)}h2{font-size:clamp(2.3rem,6vw,4rem)}h3{font-size:2rem}
em{font-style:normal;color:var(--red)}
.wrap{width:min(1160px,100% - 32px);margin-inline:auto}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{position:absolute;left:-999px;top:8px;background:var(--ink);color:#fff;padding:10px 14px;z-index:99}.skip:focus{left:8px}
.ribbon{background:var(--ink);color:#fff;font:400 .85rem/1.3 var(--fb);padding:8px 44px 8px 16px;position:relative;text-align:center}.ribbon[hidden]{display:none}
.ribbon button{position:absolute;right:6px;top:50%;translate:0 -50%;border:0;background:none;font-size:1.5rem;cursor:pointer;min-width:44px;min-height:44px;color:#fff}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 26px;background:var(--red);color:#fff;font:700 1rem/1 var(--fb);letter-spacing:.03em;text-decoration:none;border:2px solid var(--red);border-radius:999px;cursor:pointer;transition:background .2s,transform .2s;text-align:center}
.btn:hover{background:var(--red2);border-color:var(--red2);transform:translateY(-2px)}.btn-ghost{background:transparent;color:var(--teal2);border-color:var(--teal)}.btn-ghost:hover{background:var(--teal);color:#fff;border-color:var(--teal)}.btn-sm{min-height:44px;padding:0 18px;font-size:.92rem}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--ink);outline-offset:3px;box-shadow:0 0 0 6px var(--gold)}
.chips input:focus-visible+span{outline:3px solid var(--ink);outline-offset:2px;box-shadow:0 0 0 5px var(--gold)}
.kicker{font:700 .8rem var(--fb);letter-spacing:.2em;text-transform:uppercase;color:var(--teal);margin:0 0 10px}
.lede{font-size:1.1rem;color:var(--mut);max-width:62ch;margin:16px 0 0}
.fine,.mini{font-size:.88rem;color:var(--mut)}.fine a{color:var(--teal2)}.sec{padding:clamp(56px,9vw,104px) 0}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
.top{position:sticky;top:0;z-index:30;display:flex;align-items:center;gap:16px;padding:4px 20px;background:#fff;border-bottom:4px solid var(--gold)}
.brand{display:block;line-height:0}.brand img{height:64px;width:auto}
.top nav{margin-left:auto;display:flex;align-items:center;gap:22px}.top nav a:not(.btn){text-decoration:none;font-weight:700;font-size:.95rem;padding:10px 2px}.top nav a:not(.btn):hover{color:var(--red)}
.burger{display:none;margin-left:auto;width:46px;height:46px;border:0;background:none;cursor:pointer;flex-direction:column;gap:6px;align-items:center;justify-content:center}.burger i{display:block;width:26px;height:3px;background:var(--ink);border-radius:2px}
.hero{background:var(--teal);color:#fff;position:relative}
.awning{height:30px;background:repeating-linear-gradient(90deg,var(--cream) 0 44px,var(--teal2) 44px 88px);border-bottom:6px solid var(--gold);position:relative}
.hero-in{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;padding:clamp(36px,6vw,72px) 0}
.pill{display:inline-flex;align-items:center;gap:10px;background:#fff;color:var(--ink);border-radius:999px;padding:7px 16px;font-weight:700;font-size:.9rem;margin:0 0 20px}
.dot{width:10px;height:10px;border-radius:50%;background:var(--red)}.is-open .dot{background:var(--ok);box-shadow:0 0 0 4px #1E8A4C33}
.hero em{color:var(--gold)}
.sub{font-size:1.15rem;color:#E4F2F1;margin:20px 0 0;max-width:46ch}
.hero .btn-ghost{color:#fff;border-color:var(--gold)}.hero .btn-ghost:hover{background:var(--gold);color:var(--ink);border-color:var(--gold)}
.facts{list-style:none;display:flex;flex-wrap:wrap;gap:12px 28px;padding:0;margin:30px 0 0}.facts li{display:grid}.facts b{font:700 1.9rem/1 var(--fd);color:var(--gold);text-transform:uppercase}.facts span{font-size:.85rem;color:#CFE6E4}
.hero-ph{margin:0;border-radius:200px 200px 24px 24px;overflow:hidden;border:6px solid var(--gold);aspect-ratio:4/5;max-height:640px;justify-self:center;width:100%;max-width:520px;background:var(--teal2)}.hero-ph img{width:100%;height:100%;object-fit:cover}
.quick{background:var(--gold);color:var(--ink)}.qgrid{display:grid;grid-template-columns:repeat(4,1fr)}
.qgrid a{display:grid;padding:18px 16px;text-decoration:none;border-left:1px solid #0000002b}.qgrid a:last-child{border-right:1px solid #0000002b}.qgrid b{font:700 1.4rem/1.1 var(--fd);text-transform:uppercase}.qgrid span{font-size:.9rem}.qgrid a:hover{background:var(--gold2)}
.pm{background:var(--paper)}
.pm-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;margin-top:36px;align-items:start}
.pm-form{display:grid;gap:22px}.pm-form fieldset{border:0;padding:0;margin:0;min-width:0}.pm-form legend{font:700 1.5rem/1 var(--fd);text-transform:uppercase;margin-bottom:10px;color:var(--teal2)}.pm-form legend small{font:400 .85rem var(--fb);color:var(--mut);text-transform:none;margin-left:6px}
.chips{display:flex;flex-wrap:wrap;gap:8px}.chips label{position:relative}.chips input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}
.chips span{display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border:2px solid var(--teal);border-radius:999px;font-weight:700;font-size:.95rem;background:#fff;color:var(--teal2);cursor:pointer}
.chips input:checked+span{background:var(--teal);color:#fff}.chips input:disabled+span{opacity:.4;text-decoration:line-through;cursor:not-allowed;border-color:#8aa}
.chips.tops span{min-height:40px;padding:0 13px;font-size:.88rem;border-color:var(--gold-d);color:var(--ink)}.chips.tops input:checked+span{background:var(--gold);color:var(--ink);box-shadow:inset 0 0 0 2px var(--ink)}
.pm-gourmet{display:grid;gap:6px;background:var(--gold2);padding:14px;border-radius:14px}.pm-gourmet label{font-weight:700}.pm-gourmet select{min-height:46px;font:400 1rem var(--fb);border:2px solid var(--teal);border-radius:10px;padding:0 10px;background:#fff;max-width:340px;width:100%}.pm-gourmet p{margin:0}
.pm-actions{display:flex;flex-wrap:wrap;gap:16px;align-items:center}.qty{display:flex;align-items:center;gap:10px;font-weight:700}.qty button{width:44px;height:44px;border-radius:50%;border:2px solid var(--teal);background:#fff;font:700 1.4rem/1 var(--fb);color:var(--teal2);cursor:pointer}.qty output{min-width:28px;text-align:center;font:700 1.3rem var(--fm)}
.tape-wrap{position:sticky;top:96px;display:grid;gap:12px}
.tape{background:#fff;font-family:var(--fm);font-size:.92rem;padding:22px 20px 26px;color:#222;box-shadow:0 10px 30px #0e5a602e;border-top:6px solid var(--teal);position:relative;--z:linear-gradient(135deg,transparent 8px,#fff 0) 0 0/16px 16px;
 -webkit-mask:conic-gradient(from -45deg at bottom,#0000,#000 1deg 89deg,#0000 90deg) 50%/14px 100%;mask:conic-gradient(from -45deg at bottom,#0000,#000 1deg 89deg,#0000 90deg) 50%/14px 100%;padding-bottom:34px}
.tape-h{text-align:center;margin:0 0 12px;font-weight:400;letter-spacing:.06em;border-bottom:2px dashed #999;padding-bottom:12px}.tape-h small{font-size:.74rem;color:#555}
.tape ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}.tape li{display:grid;grid-template-columns:1fr auto;gap:2px 10px}.tape li .l{font-weight:700;text-transform:uppercase}.tape li .r{text-align:right}.tape li .s{grid-column:1/2;font-size:.78rem;color:#555}.tape li .x{grid-column:1/-1;justify-self:start;background:none;border:0;font:inherit;font-size:.78rem;color:var(--red2);text-decoration:underline;cursor:pointer;min-height:32px;padding:0}.tape li.empty{display:block;color:#666}
.tape-sum{display:flex;justify-content:space-between;align-items:baseline;border-top:2px dashed #999;margin-top:14px;padding-top:12px;font-size:1.05rem}.tape-sum b{font:700 1.7rem/1 var(--fm)}
.tape-note{font-size:.76rem;color:#555;margin:8px 0 0}
.tape-btns{display:flex;flex-wrap:wrap;gap:10px}.tape-btns .btn{flex:1 1 150px}
.gd{background:var(--ink);color:#fff;background-image:radial-gradient(circle at 12% 20%,#1a2b2c 0,transparent 55%)}
.gd .kicker{color:var(--gold)}.gd em{color:var(--gold)}.gd .lede{color:#D9E3E1}.gd .fine{color:#B5C4C1}
.gd-in{display:grid;grid-template-columns:1.1fr 1fr;gap:44px;align-items:center}.gd-ph{margin:0;border-radius:18px;overflow:hidden;border:4px solid var(--gold)}.gd-ph img{width:100%}
.gd-math{width:100%;border-collapse:collapse;margin:22px 0 14px;font-size:1rem}.gd-math th,.gd-math td{padding:9px 0;border-bottom:1px solid #ffffff2b;text-align:left;font-weight:400}.gd-math td{text-align:right;font-family:var(--fm)}.gd-math .sub th,.gd-math .sub td{font-weight:700;color:#fff}.gd-math .tot th,.gd-math .tot td{color:var(--gold);font-weight:700;font-size:1.1rem;border-bottom:0}
.menu{background:var(--cream)}
.m-bar{display:grid;gap:12px;margin-top:30px;position:sticky;top:70px;z-index:10;background:var(--cream);padding:10px 0}
.m-tabs{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;scrollbar-width:thin}.m-tabs button{flex:none;min-height:46px;padding:0 18px;border:2px solid var(--teal);border-radius:999px;background:#fff;font:700 .95rem var(--fb);color:var(--teal2);cursor:pointer;white-space:nowrap}.m-tabs button[aria-selected=true]{background:var(--teal);color:#fff}
.m-q input{width:100%;min-height:48px;border:2px solid var(--ink);border-radius:12px;padding:0 14px;font:400 1rem var(--fb);background:#fff}
.m-count{font-weight:700;color:var(--teal2);min-height:1.4em;margin:8px 0}
.m-panel[hidden],.m-it[hidden],.m-none[hidden]{display:none}
.m-ph{display:grid;grid-template-columns:minmax(0,280px) 1fr;gap:24px;align-items:center;margin:14px 0 20px;background:var(--teal);color:#fff;border-radius:18px;overflow:hidden}.m-ph:not(:has(img)){grid-template-columns:1fr;padding:6px 0}.m-ph img{width:100%;height:100%;object-fit:cover;min-height:150px}.m-ph>div{padding:18px 22px 18px 0}.m-ph:not(:has(img))>div{padding:18px 22px}
.m-ph h3{color:var(--gold);font-size:2.4rem}.m-note{margin:8px 0 0;color:#E4F2F1;font-size:.98rem}
.m-sizes{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 0}.m-sizes span{background:var(--gold);color:var(--ink);border-radius:999px;padding:6px 16px;font:700 1.15rem/1 var(--fd);text-transform:uppercase;letter-spacing:.02em}.m-sizes small,.m-p small{font:700 .66rem var(--fb);letter-spacing:.1em;text-transform:uppercase;margin-right:8px;opacity:.85}
.m-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:0 36px}
.m-it{display:grid;grid-template-columns:auto 1fr auto;gap:4px 14px;padding:16px 0;border-bottom:1px dashed var(--teal);align-items:start}.m-it:not(:has(.m-th)){grid-template-columns:1fr auto}
.m-th{width:92px;height:70px;object-fit:cover;border-radius:10px;border:2px solid var(--gold)}
.m-n b{display:block;font:700 1.35rem/1.1 var(--fd);text-transform:uppercase;letter-spacing:.015em}.m-n span{display:block;color:var(--mut);font-size:.93rem;line-height:1.4;margin-top:3px}
.m-p{display:flex;flex-direction:column;align-items:flex-end;gap:1px;font:700 1.05rem var(--fm);color:var(--red2);white-space:nowrap}.m-p small{color:var(--ink);margin:0 6px 0 0}.m-p.ask{font:400 .8rem var(--fb);color:var(--mut);white-space:normal;text-align:right;max-width:90px}
.m-none{font-weight:700;margin:24px 0}
.photos{background:var(--teal);color:#fff}.photos .kicker{color:var(--gold)}.photos em{color:var(--gold)}
.reel{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:30px}.reel figure{margin:0;border-radius:16px;overflow:hidden;border:3px solid var(--gold);aspect-ratio:4/5}.reel img{width:100%;height:100%;object-fit:cover}
.visit{background:var(--paper)}.visit-in{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
.addr{font-size:1.25rem;margin:18px 0 6px;font-weight:700}.phones{display:flex;flex-wrap:wrap;gap:12px;margin:10px 0 0}.tel{display:grid;text-decoration:none;font:700 1.9rem/1.1 var(--fd);letter-spacing:.02em;color:var(--teal2);border:2px solid var(--teal);border-radius:14px;padding:10px 18px;min-height:44px}.tel:hover{background:var(--teal);color:#fff}.tel small{font:700 .7rem var(--fb);letter-spacing:.14em;text-transform:uppercase;opacity:.8}
.hours{background:#fff;border:3px solid var(--teal);border-radius:20px;padding:22px 24px}.pl-head{display:flex;align-items:center;gap:10px;font-weight:700;margin:0 0 12px}
.hours table{width:100%;border-collapse:collapse}.hours th,.hours td{text-align:left;padding:10px 4px;border-bottom:1px dashed var(--line);font-weight:400}.hours td{text-align:right;font-family:var(--fm);font-size:.95rem}.hours tr.today th,.hours tr.today td{font-weight:700;background:var(--gold2)}
.foot{background:var(--ink);color:#E8EFEE;padding:30px 0}.foot a{color:var(--gold)}.foot p{margin:0 0 6px}.foot .mini{color:#A9B8B5}
.dock{display:none}
@media (max-width:900px){
 .hero-in,.pm-grid,.gd-in,.visit-in{grid-template-columns:1fr}.hero-ph{max-width:420px;border-radius:160px 160px 20px 20px}
 .tape-wrap{position:static}.m-list{grid-template-columns:1fr}.reel{grid-template-columns:1fr 1fr}.qgrid{grid-template-columns:1fr 1fr}.qgrid a:nth-child(2){border-right:1px solid #0000002b}
 .burger{display:flex}.top nav{display:none;position:absolute;left:0;right:0;top:100%;flex-direction:column;align-items:stretch;gap:0;background:#fff;padding:10px 20px 18px;border-bottom:4px solid var(--gold)}.top nav.open{display:flex}.top nav a:not(.btn){padding:14px 2px;border-bottom:1px solid var(--line)}.top nav .btn{margin-top:12px}
 .m-ph{grid-template-columns:1fr}.m-ph img{height:170px}.m-ph>div{padding:0 18px 18px}.m-bar{top:62px}
 .dock{display:grid;grid-template-columns:1fr 1.4fr 1fr;position:fixed;left:0;right:0;bottom:0;z-index:40;background:var(--ink);border-top:3px solid var(--gold)}.dock a{display:grid;place-items:center;min-height:60px;color:#fff;text-decoration:none;font-weight:700}.dock .pri{background:var(--red)}
}
@media (max-width:480px){.brand img{height:50px}.reel figure.wide{aspect-ratio:4/3}.reel{grid-template-columns:1fr 1fr}.tel{font-size:1.6rem;width:100%}.m-ph h3{font-size:2rem}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
