:root{--mar:#5B2740;--mar2:#3E1829;--mar3:#7A3A57;--gold:#F2B33D;--gold-d:#9A6508;--paper:#FBF6EC;--paper2:#F1E7D3;--ink:#1E1219;--mut:#5E4F57;--line:#DCCDB4;--blue:#5F73B5;--ok:#1E8E3E;--f:"Outfit",system-ui,sans-serif;--hand:"Nothing You Could Do","Outfit",cursive}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:84px;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font:400 1.06rem/1.6 var(--f);overflow-x:hidden}main{overflow-x:clip}
img{max-width:100%;height:auto;display:block}a{color:inherit}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{position:absolute;left:-999px;top:8px;background:var(--gold);color:var(--ink);padding:10px 14px;z-index:99;border-radius:8px}.skip:focus{left:8px}
.wrap{width:min(1180px,100% - 32px);margin-inline:auto}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.ribbon{background:var(--gold);color:var(--ink);font:600 .85rem/1.3 var(--f);padding:8px 44px 8px 16px;position:relative;text-align:center}.ribbon[hidden]{display:none}
.ribbon button{position:absolute;right:6px;top:50%;translate:0 -50%;border:0;background:none;font-size:1.5rem;cursor:pointer;min-width:44px;min-height:44px;color:var(--ink)}
.top{position:sticky;top:0;z-index:30;display:flex;align-items:center;gap:20px;padding:6px max(16px,calc((100% - 1180px)/2));background:var(--mar);border-bottom:4px double var(--blue)}
.brand{margin-right:auto;display:flex;align-items:center;gap:12px;text-decoration:none;color:#fff}.brand img{width:52px;height:52px;border-radius:8px}.brand span{display:grid;line-height:1}.brand b{font:700 1.35rem/1 var(--f);letter-spacing:.01em}.brand i{font:400 .78rem/1.2 var(--f);font-style:normal;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)}
.top nav{display:flex;gap:2px}.top nav a{display:inline-flex;align-items:center;min-height:44px;padding:0 14px;color:#fff;text-decoration:none;font:500 .95rem/1 var(--f)}.top nav a:hover{color:var(--gold)}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 26px;background:var(--mar);color:#fff;border:2px solid var(--mar);border-radius:999px;font:600 1rem/1 var(--f);text-decoration:none;cursor:pointer;transition:transform .15s,background .15s}
.btn:hover{transform:translateY(-2px);background:var(--mar2);border-color:var(--mar2)}.btn-ghost{background:transparent;color:var(--mar)}.btn-ghost:hover{background:var(--mar);color:#fff}
.btn-gold{background:var(--gold);border-color:var(--gold);color:var(--ink)}.btn-gold:hover{background:#FFC85F;border-color:#FFC85F}.btn-light{background:transparent;color:#fff;border-color:#fff}.btn-light:hover{background:#fff;color:var(--mar)}.btn-sm{min-height:44px;padding:0 20px;font-size:.92rem;background:var(--gold);border-color:var(--gold);color:var(--ink)}.btn-sm:hover{background:#FFC85F;border-color:#FFC85F}
@media(max-width:900px){.top nav{display:none}}
/* hero */
.hero{position:relative;background:var(--paper);overflow:hidden}
.hero::before{content:"";position:absolute;inset:auto -10% -140px 40%;height:420px;background:var(--mar);border-radius:50%;opacity:.07}
.hero-in{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(24px,4vw,64px);align-items:center;padding:clamp(34px,6vw,84px) 0 clamp(40px,5vw,70px);position:relative}
.eyebrow{display:inline-flex;align-items:center;gap:10px;margin:0 0 18px;padding:8px 16px;background:#fff;border:2px solid var(--mar);border-radius:999px;font:600 .9rem/1.2 var(--f)}
.dot{width:10px;height:10px;border-radius:50%;background:#999}.is-open .dot{background:var(--ok);box-shadow:0 0 0 4px rgba(30,142,62,.25)}
h1{font:700 clamp(2.6rem,6.4vw,5.2rem)/1.02 var(--f);margin:0 0 18px;letter-spacing:-.025em;color:var(--mar)}h1 em{font-style:normal;color:var(--ink);background:linear-gradient(transparent 62%,var(--gold) 62% 92%,transparent 92%)}
.sub{font-size:1.2rem;max-width:46ch;margin:0 0 26px;color:var(--mut)}.cta{display:flex;gap:12px;flex-wrap:wrap}.mini{margin:20px 0 0;color:var(--mut);font-weight:500}.mini a{text-decoration-color:var(--gold);text-underline-offset:4px}
.collage{position:relative;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:auto auto;gap:14px;align-items:start}
.collage figure{margin:0;border-radius:20px;overflow:hidden;border:5px solid #fff;box-shadow:0 14px 34px rgba(62,24,41,.22)}.collage img{width:100%;height:100%;object-fit:cover}
.c1{grid-column:1/3;aspect-ratio:16/10;rotate:-1.2deg}.c2{aspect-ratio:1;rotate:1.8deg;margin-top:-2px}.c3{aspect-ratio:1;rotate:-1.5deg}
.stamp{position:absolute;right:-6px;top:-18px;margin:0;width:104px;height:104px;border-radius:50%;background:var(--gold);color:var(--ink);display:grid;place-content:center;text-align:center;rotate:10deg;border:3px dashed var(--mar);z-index:2}.stamp b{font:600 .7rem/1 var(--f);letter-spacing:.22em;text-transform:uppercase}.stamp span{font:700 1.9rem/1 var(--f)}
@media(max-width:900px){.hero-in{grid-template-columns:1fr}.stamp{right:6px;top:-30px;width:88px;height:88px}.stamp span{font-size:1.5rem}}
.sec{padding:clamp(56px,8vw,100px) 0}.sec-head{max-width:800px;margin-bottom:34px}
.kicker{font:600 .85rem/1.3 var(--f);letter-spacing:.16em;text-transform:uppercase;color:var(--gold-d);margin:0 0 10px}
h2{font:700 clamp(2rem,4.6vw,3.3rem)/1.08 var(--f);margin:0 0 14px;letter-spacing:-.02em;color:var(--mar)}h2 em{font-style:normal;color:var(--ink)}h3{font:700 1.45rem/1.2 var(--f);margin:0 0 8px;color:var(--mar)}
.lede{font-size:1.15rem;color:var(--mut);margin:0}.fine{font-size:.9rem;color:var(--mut);margin:16px 0 0}
/* the week */
.week{background:var(--mar);color:#fff;position:relative}.week::before{content:"";position:absolute;inset:0 0 auto;height:8px;background:repeating-linear-gradient(90deg,var(--blue) 0 28px,var(--mar) 28px 40px)}
.week h2{color:#fff}.week h2 em{color:var(--gold)}.week .kicker{color:var(--gold)}.week .lede,.week .fine{color:#E9D7DF}
.cal{display:grid;gap:18px}
.rail{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
.rail button{position:relative;display:grid;gap:2px;justify-items:center;padding:12px 4px 10px;background:var(--mar3);border:2px solid transparent;border-radius:14px;color:#fff;cursor:pointer;font-family:var(--f);transition:background .15s,transform .15s;min-height:72px}
.rail button:hover{background:#8C4766}.rail .d{font:700 1.15rem/1 var(--f);letter-spacing:.04em;text-transform:uppercase}.rail .p{font:500 .78rem/1.2 var(--f);color:#F5DDE8;text-align:center}
.rail button[aria-selected=true]{background:var(--paper);color:var(--mar);transform:translateY(-4px)}.rail button[aria-selected=true] .p{color:var(--mut)}
.rail .td{display:none;position:absolute;top:-10px;left:50%;translate:-50% 0;background:var(--gold);color:var(--ink);font:700 .62rem/1 var(--f);letter-spacing:.1em;text-transform:uppercase;padding:4px 8px;border-radius:999px;font-style:normal}.rail button.today .td{display:block}
.sheet{position:relative;background:var(--paper);color:var(--ink);border-radius:20px;padding:34px clamp(18px,3.4vw,40px) clamp(20px,3vw,34px);box-shadow:0 20px 0 -8px var(--mar3),0 24px 40px rgba(0,0,0,.25);margin-top:14px}
.binding{position:absolute;top:-12px;left:0;right:0;display:flex;justify-content:space-around;padding:0 8%}.binding i{width:18px;height:30px;border-radius:9px;background:var(--gold);border:3px solid var(--mar2);display:block}
.sheet-in{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(18px,4vw,50px);align-items:start;padding-bottom:20px;border-bottom:3px double var(--line)}
.sday{font:600 .95rem/1 var(--f);letter-spacing:.2em;text-transform:uppercase;color:var(--gold-d);margin:0 0 10px}.sheet h3{font:700 clamp(2rem,4.6vw,3.4rem)/1.05 var(--f);letter-spacing:-.02em;margin:0 0 10px}.line{margin:0;font:400 clamp(1.2rem,2vw,1.5rem)/1.3 var(--hand);color:var(--ink)}
.sheet-r{display:grid;gap:8px;align-content:start}.sheet-r label{font:600 .9rem/1.3 var(--f);color:var(--mut);margin-top:4px}.sheet-r small{color:var(--mut)}
.step{display:flex;align-items:stretch;border:2px solid var(--mar);border-radius:14px;overflow:hidden;background:#fff;width:fit-content}.step button{width:56px;min-height:56px;border:0;background:var(--paper2);font:700 1.6rem/1 var(--f);color:var(--mar);cursor:pointer}.step button:hover{background:var(--gold)}
.step input{width:84px;border:0;text-align:center;font:700 1.5rem/1 var(--f);color:var(--ink);background:#fff;-moz-appearance:textfield;min-height:56px}.step input::-webkit-outer-spin-button,.step input::-webkit-inner-spin-button{-webkit-appearance:none}
select{width:100%;min-height:54px;border:2px solid var(--mar);border-radius:14px;background:#fff;color:var(--ink);padding:0 14px;font:500 1rem/1 var(--f)}
.closed{font:600 1.2rem/1.4 var(--f);color:var(--mar);margin:0 0 8px}
.sheet-out{display:grid;gap:0;padding-top:16px;max-width:620px}.sheet-out>div{display:flex;justify-content:space-between;gap:16px;padding:10px 0;border-bottom:1px dotted var(--line);align-items:baseline}.sheet-out span{color:var(--mut)}.sheet-out b{font:700 1.25rem/1.2 var(--f);white-space:nowrap}
.sheet-out .reg b{text-decoration:line-through;text-decoration-color:var(--mar3);color:var(--mut)}.sheet-out .tot b{font-size:1.4rem}
.sheet-out .save{border:0;margin-top:8px;padding:14px 18px;background:var(--gold);border-radius:14px}.sheet-out .save span{color:var(--ink);font-weight:600}.sheet-out .save b{font-size:1.8rem;color:var(--ink)}
.sheet-out .btn{margin-top:16px;width:fit-content}
@media(max-width:900px){.rail{gap:5px}.rail .d{font-size:.95rem}.rail .p{font-size:.64rem}.sheet-in{grid-template-columns:1fr}}
@media(max-width:480px){.rail button{padding:12px 1px 8px;min-height:76px}.sheet-out b{font-size:1.1rem}.sheet-out .btn{width:100%}}
/* extras */
.extras{background:var(--paper2)}.ex-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:stretch}
.pie{background:var(--mar);color:#fff;border-radius:24px;padding:clamp(24px,4vw,44px);position:relative;overflow:hidden}.pie::after{content:"";position:absolute;right:-60px;bottom:-60px;width:220px;height:220px;border-radius:50%;border:26px solid var(--mar3);opacity:.5}
.pie h2{color:#fff}.pie .kicker{color:var(--gold)}.pie p{color:#F2E4EA;position:relative;z-index:1}.pp{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin:18px 0}.pp b{font:700 2.6rem/1 var(--f);color:var(--gold)}.pp span{font-weight:500}
.lunch{background:#fff;border:2px solid var(--line);border-radius:24px;overflow:hidden;display:grid;grid-template-rows:auto 1fr}.lunch img{width:100%;aspect-ratio:16/8;object-fit:cover}.lunch div{padding:clamp(18px,3vw,30px)}.lunch p{margin:0 0 10px;color:var(--mut)}.lunch .kicker{color:var(--gold-d)}.bk b{color:var(--ink)}
@media(max-width:900px){.ex-grid{grid-template-columns:1fr}}
/* menu */
.m-tools input{width:100%;min-height:56px;border:2px solid var(--mar);border-radius:999px;padding:0 24px;font:400 1.05rem/1 var(--f);background:#fff;color:var(--ink)}
.m-grid{display:grid;grid-template-columns:240px 1fr;gap:30px;margin-top:22px;align-items:start}
.m-tabs{display:grid;gap:8px;position:sticky;top:96px}.m-tabs button{display:flex;align-items:center;gap:12px;padding:6px 14px 6px 6px;background:#fff;border:2px solid var(--line);border-radius:999px;cursor:pointer;text-align:left;font:600 .98rem/1.1 var(--f);color:var(--ink);min-height:56px}
.m-tabs button img{width:44px;height:44px;border-radius:50%;object-fit:cover;flex:none}.m-tabs button:hover{border-color:var(--mar)}.m-tabs button[aria-selected=true]{background:var(--mar);border-color:var(--mar);color:#fff}
.m-panel h3{font-size:2rem;margin-bottom:10px}.m-panel[hidden]{display:none}
.m-note{background:#fff;border-left:5px solid var(--gold);border-radius:0 12px 12px 0;padding:12px 16px;margin:0 0 14px;color:var(--mut)}
.m-list{list-style:none;margin:0;padding:0;columns:2;column-gap:40px}.m-list li{break-inside:avoid;display:flex;justify-content:space-between;gap:14px;padding:13px 2px;border-bottom:1px dotted #B49E78}.m-list li[hidden]{display:none}
.m-t b{display:block;font:700 1.05rem/1.25 var(--f)}.m-t small{display:block;color:var(--mut);font-size:.9rem;line-height:1.4}
.m-pr{display:flex;gap:12px;font:700 1rem/1.2 var(--f);white-space:nowrap}.m-pr span{min-width:64px;text-align:right}.m-pr i{display:block;font:600 .62rem/1.2 var(--f);font-style:normal;letter-spacing:.08em;text-transform:uppercase;color:var(--gold-d)}
.m-empty{font:700 1.3rem/1.3 var(--f);padding:20px 0;color:var(--mar)}
@media(max-width:900px){.m-grid{grid-template-columns:1fr}.m-tabs{position:static;display:flex;overflow-x:auto;gap:8px;padding-bottom:6px;scroll-snap-type:x proximity;margin-inline:-16px;padding-inline:16px}.m-tabs button{flex:none;scroll-snap-align:start}.m-list{columns:1}}
/* party */
.party{background:#fff}.pt-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,70px);align-items:center}.pt-grid figure{margin:0;border-radius:24px;overflow:hidden;rotate:-1.5deg;border:6px solid var(--paper2);box-shadow:0 14px 34px rgba(62,24,41,.18)}
.pcalc{background:var(--paper);border:2px solid var(--line);border-radius:20px;padding:20px;margin:22px 0;display:grid;gap:10px}.pcalc label{font:600 .95rem/1.3 var(--f);color:var(--mut)}.ptot{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin:6px 0 0;flex-wrap:wrap}.ptot span{color:var(--mut)}.ptot b{font:700 2.2rem/1 var(--f);color:var(--mar)}
@media(max-width:900px){.pt-grid{grid-template-columns:1fr}}
/* story */
.story{background:var(--paper)}.tl{list-style:none;margin:0 0 36px;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.tl li{background:#fff;border-radius:18px;padding:22px;border-top:8px solid var(--gold);border-left:2px solid var(--line);border-right:2px solid var(--line);border-bottom:2px solid var(--line)}.tl b{display:block;font:700 2.2rem/1 var(--f);color:var(--mar);margin-bottom:8px}.tl p{margin:0;color:var(--mut);font-size:.98rem}
.perks{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px}.perks li{padding:9px 16px;background:var(--paper2);border-radius:999px;font:500 .95rem/1.2 var(--f);color:var(--ink)}
@media(max-width:900px){.tl{grid-template-columns:1fr 1fr}}@media(max-width:560px){.tl{grid-template-columns:1fr}}
/* visit */
.visit{background:var(--mar);color:#fff}.visit h2{color:#fff}.visit h2 em{color:var(--gold)}.visit .kicker{color:var(--gold)}
.v-grid{display:grid;grid-template-columns:.8fr 1.1fr 1fr;gap:20px;align-items:start}.hrs,.find,.join{background:var(--mar2);border-radius:20px;padding:26px}
.hrs ul{list-style:none;margin:0;padding:0}.hrs li{display:flex;justify-content:space-between;gap:12px;padding:11px 10px;border-bottom:1px dotted #8A5870}.hrs li:last-child{border:0}.hrs li.today{background:var(--gold);color:var(--ink);border-radius:10px;border-color:transparent}.hrs b{font-weight:700;text-align:right}
.addr{font:700 1.5rem/1.3 var(--f);margin:0 0 8px}.near{color:#E5D3DB;margin:0 0 12px}.tels{margin:0 0 16px}.tel{font:700 1.3rem/1.4 var(--f);text-decoration-color:var(--gold);text-underline-offset:4px}.find .btn-ghost,.join .btn-ghost{color:#fff;border-color:#fff}.find .btn-ghost:hover,.join .btn-ghost:hover{background:#fff;color:var(--mar)}.find .btn:not(.btn-ghost){background:var(--gold);border-color:var(--gold);color:var(--ink)}
.soc{margin:16px 0 0;color:#E5D3DB}.soc a{text-decoration-color:var(--gold);text-underline-offset:4px}.join h3{color:#fff}.join p{color:#E5D3DB}
@media(max-width:900px){.v-grid{grid-template-columns:1fr}}
.foot{background:var(--mar2);color:#E5D3DB;padding:22px 0 90px;font-size:.88rem}.foot .wrap{display:flex;gap:10px 30px;flex-wrap:wrap;justify-content:space-between}
.dock{position:fixed;left:0;right:0;bottom:0;z-index:40;display:none;gap:10px;padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:var(--mar2);border-top:3px solid var(--gold)}.dock .btn{flex:1;min-height:48px}.dock .btn:first-child{background:var(--gold);border-color:var(--gold);color:var(--ink)}
@media(max-width:700px){.dock{display:flex}}
.rv{opacity:0;transform:translateY(18px);transition:opacity .6s,transform .6s}.rv.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}.rv{opacity:1;transform:none}}
.tel,.soc a,.mini a{display:inline-flex;align-items:center;min-height:44px}.soc,.mini{display:flex;flex-wrap:wrap;align-items:center;gap:0 8px}.tels{display:flex;flex-wrap:wrap;align-items:center;gap:0 12px}
.m-ph{width:100%;height:clamp(140px,20vw,230px);object-fit:cover;border-radius:18px;margin-bottom:16px}
