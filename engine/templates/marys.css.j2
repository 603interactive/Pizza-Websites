:root{--paper:#FBF6EA;--paper2:#F2E8D2;--red:#B3141B;--red2:#8E0F15;--ink:#2B1D1A;--mut:#6A5A54;--green:#2E6A3E;--line:#E0D3B8;--gold:#C99A2E;--fd:"Gloock","Georgia",serif;--fb:"Crimson Pro","Georgia",serif;--fu:"Instrument Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
--gh:linear-gradient(90deg,rgba(179,20,27,.16) 50%,transparent 50%),linear-gradient(rgba(179,20,27,.16) 50%,transparent 50%)}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--paper);color:var(--ink);font:400 1.2rem/1.55 var(--fb);-webkit-font-smoothing:antialiased;padding-bottom:70px;overflow-x:hidden}
img{max-width:100%;height:auto;display:block}a{color:var(--red2)}
h1,h2,h3{font-family:var(--fd);font-weight:400;line-height:1.05;margin:0;letter-spacing:-.005em}
h1{font-size:clamp(2.7rem,7.2vw,5.2rem)}h2{font-size:clamp(2.1rem,5vw,3.4rem)}h3{font-size:1.7rem}
em{font-style:italic;color:var(--red)}
.wrap{width:min(1160px,100% - 32px);margin-inline:auto}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{position:absolute;left:-999px;top:8px;background:var(--ink);color:#fff;padding:10px 14px;z-index:99}.skip:focus{left:8px}
.ribbon{background:var(--ink);color:var(--paper);font:500 .85rem/1.3 var(--fu);padding:8px 44px 8px 16px;position:relative;text-align:center}.ribbon[hidden]{display:none}
.ribbon button{position:absolute;right:6px;top:50%;translate:0 -50%;border:0;background:none;font-size:1.5rem;cursor:pointer;min-width:44px;min-height:44px;color:var(--paper)}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 26px;background:var(--red);color:#fff;font:700 .95rem/1 var(--fu);letter-spacing:.06em;text-transform:uppercase;text-decoration:none;border:2px solid var(--red);border-radius:6px;cursor:pointer;transition:background .2s,transform .2s}
.btn:hover{background:var(--red2);border-color:var(--red2);transform:translateY(-2px)}.btn-ghost{background:transparent;color:var(--red2)}.btn-ghost:hover{background:var(--red);color:#fff}.btn-sm{min-height:42px;padding:0 18px;font-size:.85rem}
a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.kicker{font:700 .82rem var(--fu);letter-spacing:.18em;text-transform:uppercase;color:var(--green);margin:0 0 10px}
.lede{font-size:1.28rem;color:var(--mut);max-width:60ch;margin:16px 0 0}.lede.sm{font-size:1.15rem}
.fine,.mini{font-size:1rem;color:var(--mut)}.sec{padding:clamp(56px,9vw,104px) 0}
.sec-head{margin-bottom:28px}
.top{position:sticky;top:0;z-index:30;display:flex;align-items:center;gap:16px;padding:8px 20px;background:#FBF6EAF5;border-bottom:3px solid var(--red);backdrop-filter:blur(8px)}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink);font:400 1.5rem/1 var(--fd)}.brand img{width:48px;height:auto}.brand small{display:block;font:400 .78rem/1.3 var(--fu);letter-spacing:.04em;color:var(--mut);margin-top:3px}
.top nav{margin-left:auto;display:flex;align-items:center;gap:24px}.top nav a:not(.btn){font:700 .88rem var(--fu);letter-spacing:.05em;text-transform:uppercase;text-decoration:none;color:var(--ink);padding:12px 0}.top nav a:not(.btn):hover{color:var(--red)}
.burger{display:none;margin-left:auto;width:48px;height:48px;border:1px solid var(--line);border-radius:8px;background:none;color:var(--ink);cursor:pointer;position:relative}
.burger i{position:absolute;left:12px;right:12px;height:2px;background:currentColor;transition:.2s}.burger i:nth-of-type(1){top:15px}.burger i:nth-of-type(2){top:23px}.burger i:nth-of-type(3){top:31px}
.burger[aria-expanded=true] i:nth-of-type(1){top:23px;rotate:45deg}.burger[aria-expanded=true] i:nth-of-type(2){opacity:0}.burger[aria-expanded=true] i:nth-of-type(3){top:23px;rotate:-45deg}
@media(max-width:900px){.burger{display:block}.top nav{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;align-items:stretch;gap:0;background:var(--paper);padding:8px 20px 20px;border-bottom:3px solid var(--red)}.top nav.open{display:flex}.top nav a:not(.btn){padding:14px 0;border-bottom:1px solid var(--line)}.top nav .btn{margin-top:14px}}
.pill{display:inline-flex;align-items:center;gap:10px;margin:0 0 20px;padding:8px 16px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 .92rem var(--fu)}
.dot{width:11px;height:11px;border-radius:50%;background:#9a8e88;flex:none}.is-open .dot{background:#2E9E55;box-shadow:0 0 0 4px #2E9E5533}
.hero,.story{background-color:var(--paper);background-image:var(--gh);background-size:36px 36px}.hero{border-bottom:1px solid var(--line)}
.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(24px,5vw,64px);align-items:center;padding:clamp(36px,6vw,84px) max(16px,calc((100% - 1160px)/2))}
.hero-copy{background:var(--paper);padding:clamp(20px,3vw,36px);border:2px solid var(--ink);border-radius:6px;box-shadow:8px 8px 0 var(--red)}
.hero .sub{font-size:1.35rem;color:var(--mut);max-width:44ch;margin:20px 0 26px}.cta{display:flex;flex-wrap:wrap;gap:12px}.hero .mini{margin:18px 0 0}
.hero-ph{margin:0}.hero-ph img{width:100%;border:6px solid #fff;box-shadow:0 10px 30px #2b1d1a40;border-radius:4px;rotate:1.2deg}.hero-ph figcaption{font:italic 1.05rem var(--fb);color:var(--mut);margin-top:16px;text-align:center}
@media(max-width:860px){.hero{grid-template-columns:1fr}.hero-copy{box-shadow:5px 5px 0 var(--red)}}
.awards{background:var(--red);color:#fff}.awards ul{list-style:none;padding:22px 0;margin-inline:auto;display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.awards li{display:grid;gap:3px;text-align:center}.awards b{font:400 1.3rem/1.15 var(--fd)}.awards span{font:400 .95rem var(--fu);opacity:.92}
@media(max-width:760px){.awards ul{grid-template-columns:1fr;gap:16px}}
.today{background:var(--ink);color:var(--paper);padding:clamp(22px,4vw,40px);border-radius:6px;margin-bottom:20px;border-left:10px solid var(--red)}
.t-lab{font:700 .82rem var(--fu);letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin:0 0 8px}.t-big{font:400 clamp(1.6rem,3.6vw,2.5rem)/1.15 var(--fd);margin:0}.t-sub{margin:10px 0 0;color:#d8cdbd}
.dcards{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.dcards li{background:#fff;border:2px solid var(--line);border-radius:6px;padding:22px;display:grid;gap:6px;align-content:start;position:relative}
.dcards li.on{border-color:var(--red)}.dcards li.on::after{content:"Today";position:absolute;top:-12px;right:14px;background:var(--red);color:#fff;font:700 .75rem var(--fu);letter-spacing:.1em;text-transform:uppercase;padding:4px 10px;border-radius:3px}
.d-day{font:700 .8rem var(--fu);letter-spacing:.14em;text-transform:uppercase;color:var(--green)}.dcards p{margin:0;color:var(--mut)}.d-pr{font:400 2rem var(--fd);color:var(--red);margin-top:6px}
@media(max-width:820px){.dcards{grid-template-columns:1fr}}
.menu{background:var(--paper2)}
.m-bar{display:grid;gap:12px;position:sticky;top:64px;z-index:10;background:var(--paper2);padding:10px 0}
.m-tabs{display:flex;gap:8px;overflow-x:auto;padding:4px 2px 8px;scrollbar-width:thin}.m-tabs button{flex:none;min-height:44px;padding:0 16px;border:2px solid var(--ink);background:transparent;color:var(--ink);font:700 .85rem var(--fu);letter-spacing:.03em;border-radius:999px;cursor:pointer;white-space:nowrap}
.m-tabs button[aria-selected=true]{background:var(--red);border-color:var(--red);color:#fff}
.m-q input{width:100%;min-height:50px;padding:0 16px;border:2px solid var(--ink);border-radius:6px;background:#fff;font:400 1.05rem var(--fu);color:var(--ink)}
.m-count{font:700 .9rem var(--fu);color:var(--green);min-height:1.2em;margin:6px 0}
.m-panel{background:#fff;border:2px solid var(--ink);border-radius:6px;padding:clamp(18px,3vw,36px)}.m-panel[hidden]{display:none}
.m-ph{border-bottom:3px double var(--line);padding-bottom:14px;margin-bottom:6px}.m-ph p{margin:8px 0 0;color:var(--mut);max-width:70ch}
.m-list{list-style:none;padding:0;margin:0}.m-it{display:flex;justify-content:space-between;gap:20px;padding:16px 0;border-bottom:1px dotted #bfae92}.m-it:last-child{border:0}.m-it[hidden]{display:none}
.m-n{min-width:0}.m-n b{display:block;font:400 1.35rem/1.2 var(--fd)}.m-n span{display:block;color:var(--mut);margin-top:3px;max-width:62ch}
.m-p{display:flex;gap:14px;flex-wrap:wrap;justify-content:flex-end;align-content:flex-start;flex:none;max-width:48%}.m-p span{display:grid;justify-items:end;font:700 1.05rem var(--fu);color:var(--red2);white-space:nowrap}.m-p small{font:400 .72rem var(--fu);color:var(--mut);text-transform:uppercase;letter-spacing:.05em}
.m-none{font:700 1rem var(--fu)}
@media(max-width:620px){.m-it{flex-direction:column;gap:8px}.m-p{justify-content:flex-start;max-width:none}.m-p span{justify-items:start}}
.build-in{display:grid;grid-template-columns:1.25fr .75fr;gap:12px 40px;align-items:start}.build-in .sec-head{grid-column:1/-1}
@media(max-width:900px){.build-in{grid-template-columns:1fr}}
.bld{display:grid;gap:18px}.bld fieldset{border:2px solid var(--line);border-radius:6px;padding:16px 18px 18px;margin:0;background:#fff}
.bld legend{font:700 .85rem var(--fu);letter-spacing:.12em;text-transform:uppercase;color:var(--green);padding:0 8px}.cnt{color:var(--mut);letter-spacing:0;text-transform:none;font-weight:400;margin-left:6px}
.opts,.tops{display:flex;flex-wrap:wrap;gap:8px}.tops{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr))}
.bld label{position:relative;display:block}.bld input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}
.bld label span{display:flex;align-items:center;min-height:44px;padding:0 14px;border:2px solid var(--line);border-radius:6px;font:400 1rem var(--fu);background:var(--paper);transition:.15s}
.bld input:checked+span{background:var(--red);border-color:var(--red);color:#fff;font-weight:700}.bld input:focus-visible+span{outline:3px solid var(--gold);outline-offset:2px}.bld input:disabled+span{opacity:.4}
.ticket{position:sticky;top:84px;background:#fff;border:2px solid var(--ink);border-radius:6px;padding:26px;box-shadow:8px 8px 0 var(--red);background-image:repeating-linear-gradient(transparent 0 31px,#e9dcc233 31px 32px)}
.tk-h{font:700 .82rem var(--fu);letter-spacing:.18em;text-transform:uppercase;color:var(--green);margin:0}.tk-d{margin:8px 0;font-size:1.2rem}.tk-p{font:400 3.4rem/1 var(--fd);color:var(--red);margin:6px 0 10px}.tk-f{font-size:.95rem;color:var(--mut)}
@media(max-width:900px){.ticket{position:static}}
.story{border-block:1px solid var(--line)}
.story-in{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(24px,5vw,64px);align-items:center}
.s-a{margin:0}.s-a img{width:100%;border:8px solid #fff;box-shadow:0 10px 30px #2b1d1a40;rotate:-1.5deg;filter:sepia(.15)}.s-a figcaption{font:italic 1.05rem var(--fb);color:var(--mut);margin-top:14px;text-align:center}
.s-t{background:var(--paper);padding:clamp(18px,3vw,32px);border-radius:6px}
@media(max-width:820px){.story-in{grid-template-columns:1fr}}
.fam-h{margin:56px auto 18px;text-align:center;background:var(--paper);width:fit-content;max-width:100%;padding:8px 22px;border-radius:6px}.fam{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:0;counter-reset:f;position:relative}
.fam li{position:relative;text-align:center;padding:30px 10px 0;display:grid;gap:3px;justify-items:center;align-content:start}
.fam li::before{content:"";position:absolute;top:8px;left:0;right:0;border-top:3px solid var(--red)}.fam li:first-child::before{left:50%}.fam li:last-child::before{right:50%}
.fam li::after{content:"";position:absolute;top:0;left:50%;translate:-50% 0;width:18px;height:18px;border-radius:50%;background:var(--paper);border:4px solid var(--red)}
.fam b{font:400 1.35rem/1.2 var(--fd)}.fam i{color:var(--mut)}
@media(max-width:620px){.fam{grid-template-columns:1fr;gap:6px}.fam li{padding:8px 0 8px 40px;text-align:left;justify-items:start}.fam li::before{top:0;bottom:0;left:9px;right:auto;border-top:0;border-left:3px solid var(--red)}.fam li:first-child::before{top:50%;left:9px}.fam li:last-child::before{bottom:50%;right:auto}.fam li::after{top:50%;left:0;translate:0 -50%}}
.quote{max-width:62ch;margin:36px auto 0;padding:20px 24px;background:var(--paper);border-radius:6px;text-align:center;font:italic 1.35rem/1.5 var(--fb)}
.treats{background:var(--paper);padding:18px;border-radius:6px;display:grid;grid-template-columns:150px 150px 1fr;gap:16px;align-items:center;max-width:760px;margin:44px auto 0}.treats figure{margin:0}.treats img{width:100%;aspect-ratio:3/4;object-fit:cover;border:5px solid #fff;box-shadow:0 6px 16px #2b1d1a33}
@media(max-width:560px){.treats{grid-template-columns:1fr 1fr}.treats div{grid-column:1/-1}}
.visit-in{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,64px);align-items:start}
.addr{font:400 1.5rem/1.35 var(--fd);margin:20px 0 6px}.tel{font:400 clamp(2rem,6vw,2.8rem) var(--fd);text-decoration:none;color:var(--red)}.visit .cta{margin:20px 0}.soc{margin:0}
.hours{background:#fff;border:2px solid var(--ink);border-radius:6px;padding:24px;box-shadow:8px 8px 0 var(--red)}.pl-head{display:flex;align-items:center;gap:10px;margin:0 0 12px;font:700 1rem var(--fu)}
.hours table{width:100%;border-collapse:collapse}.hours th,.hours td{padding:11px 4px;border-bottom:1px dotted #bfae92;text-align:left;font:400 1.15rem var(--fb)}.hours th{font-weight:700}.hours td{text-align:right}
.hours tr.tnow th,.hours tr.tnow td{color:var(--red);font-weight:700}
@media(max-width:820px){.visit-in{grid-template-columns:1fr}}
.foot{background:var(--ink);color:var(--paper);padding:34px 0}.foot .wrap{display:flex;align-items:center;gap:20px}.foot img{width:72px;height:auto;background:#fff;border-radius:50%;padding:6px;flex:none}.foot p{margin:0 0 6px}.foot a{color:#fff}.foot .mini{color:#cfc3b3}
.dock{display:none}
@media(max-width:820px){.dock{display:grid;grid-template-columns:1fr 1.4fr 1fr;position:fixed;left:0;right:0;bottom:0;z-index:40;background:var(--ink);border-top:3px solid var(--red)}.dock a{display:flex;align-items:center;justify-content:center;min-height:56px;color:#fff;text-decoration:none;font:700 .85rem var(--fu);letter-spacing:.08em;text-transform:uppercase}.dock a.pri{background:var(--red)}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
