:root{--night:#12141C;--night2:#1B1E2A;--night3:#262A3A;--red:#C32728;--redhi:#E04A44;--cream:#F6EEDD;--mut:#B3B2BD;--line:#343849;--gold:#F2B84B;--ok:#4CD08A;--fd:"Smooch Sans","Arial Narrow",Impact,sans-serif;--fb:"Outfit",system-ui,-apple-system,"Segoe UI",sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--night) radial-gradient(ellipse 70% 600px at 85% 280px,#C3272833,transparent) no-repeat;color:var(--cream);font:400 1rem/1.6 var(--fb);-webkit-font-smoothing:antialiased;padding-bottom:68px;overflow-x:hidden}
img{max-width:100%;height:auto;display:block}a{color:inherit}
h1,h2,h3,h4{font-family:var(--fd);font-weight:500;line-height:.9;margin:0;text-transform:uppercase;letter-spacing:.015em}
h1{font-size:clamp(4rem,13vw,9rem)}h2{font-size:clamp(2.6rem,7vw,4.6rem)}h3{font-size:2rem}
em{font-style:normal;color:var(--redhi)}
.wrap{width:min(1180px,100% - 32px);margin-inline:auto}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{position:absolute;left:-999px;top:8px;background:var(--cream);color:var(--night);padding:10px 14px;z-index:99}.skip:focus{left:8px}
.ribbon{background:var(--cream);color:var(--night);font:500 .85rem/1.3 var(--fb);padding:8px 44px 8px 16px;position:relative;text-align:center}.ribbon[hidden]{display:none}
.ribbon button{position:absolute;right:6px;top:50%;translate:0 -50%;border:0;background:none;font-size:1.5rem;cursor:pointer;min-width:44px;min-height:44px;color:var(--night)}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 26px;background:var(--red);color:#fff;font:500 1.35rem/1 var(--fd);letter-spacing:.07em;text-transform:uppercase;text-decoration:none;border:2px solid var(--red);border-radius:999px;cursor:pointer;transition:background .2s,transform .2s}
.btn:hover{background:#A31F20;border-color:#A31F20;transform:translateY(-2px)}.btn-ghost{background:transparent;color:var(--cream);border-color:var(--cream)}.btn-ghost:hover{background:var(--cream);color:var(--night);border-color:var(--cream)}.btn-sm{min-height:42px;padding:0 20px;font-size:1.2rem}
a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.kicker{font:500 1.25rem var(--fd);letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin:0 0 10px}
.lede{font-size:1.1rem;color:var(--mut);max-width:62ch;margin:16px 0 0}.lede.sm{font-size:1rem}.lede a{color:var(--cream)}
.fine,.mini{font-size:.88rem;color:var(--mut)}.sec{padding:clamp(64px,10vw,120px) 0}
.top{position:sticky;top:0;z-index:30;display:flex;align-items:center;gap:16px;padding:8px 20px;background:#12141Cf2;border-bottom:1px solid var(--line);backdrop-filter:blur(8px)}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;font:500 1.3rem/.95 var(--fd);letter-spacing:.06em;text-transform:uppercase}.brand img{width:46px;height:46px;border-radius:8px}
.top nav{margin-left:auto;display:flex;align-items:center;gap:26px}.top nav a:not(.btn){font:500 1.25rem var(--fd);letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:12px 0}.top nav a:not(.btn):hover{color:var(--gold)}
.burger{display:none;margin-left:auto;width:48px;height:48px;border:1px solid var(--line);border-radius:10px;background:none;color:var(--cream);cursor:pointer;position:relative}
.burger i{position:absolute;left:12px;right:12px;height:2px;background:currentColor;transition:.2s}.burger i:nth-of-type(1){top:15px}.burger i:nth-of-type(2){top:23px}.burger i:nth-of-type(3){top:31px}
.burger[aria-expanded=true] i:nth-of-type(1){top:23px;rotate:45deg}.burger[aria-expanded=true] i:nth-of-type(2){opacity:0}.burger[aria-expanded=true] i:nth-of-type(3){top:23px;rotate:-45deg}
@media(max-width:820px){.burger{display:block}.top nav{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;align-items:stretch;gap:0;background:var(--night2);padding:8px 20px 20px;border-bottom:1px solid var(--line)}.top nav.open{display:flex}.top nav a:not(.btn){padding:14px 0;border-bottom:1px solid var(--line)}.top nav .btn{margin-top:14px}}
.pill{display:inline-flex;align-items:center;gap:10px;margin:0 0 20px;padding:8px 16px;border:1px solid var(--line);border-radius:999px;background:var(--night2);font-size:.95rem;font-weight:700}
.dot{width:11px;height:11px;border-radius:50%;background:#8a8a95;flex:none}.is-open .dot{background:var(--ok);box-shadow:0 0 0 4px #4cd08a33}
.hero{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center;width:min(1180px,100% - 32px);margin-inline:auto;padding:clamp(36px,6vw,80px) 0;position:relative}
.hero-copy{position:relative;width:auto;margin:0}.hero .sub{font-size:1.2rem;color:var(--mut);max-width:44ch;margin:22px 0 28px}.cta{display:flex;flex-wrap:wrap;gap:12px}.hero .mini{margin-top:18px}
.hero-ph{margin:0;position:relative}.hero-ph img{width:100%;max-height:78svh;object-fit:cover;border-radius:200px 200px 16px 16px;border:1px solid var(--line);box-shadow:0 30px 80px #0008}
@media(max-width:820px){.hero{grid-template-columns:1fr}.hero-ph{order:-1}.hero-ph img{max-height:340px;border-radius:120px 120px 16px 16px;object-position:center 30%}}
.late{background:var(--night2);border-block:1px solid var(--line)}
.ls{margin-top:36px;position:relative}
.ls-read{font:500 clamp(1.8rem,5vw,2.8rem)/1.05 var(--fd);text-transform:uppercase;margin:0 0 22px;min-height:2.2em}.ls-read b{color:var(--gold);font-weight:500}.ls-read span{color:var(--ok)}.ls-read .cl{color:var(--redhi)}
.ls-chart{position:relative;--lab:64px;--hrs:150px}
.ls-axis{position:relative;height:26px;margin:0 var(--hrs) 4px var(--lab)}.ls-axis span{white-space:nowrap;position:absolute;top:0;translate:-50% 0;font-size:.8rem;color:var(--mut)}
.ls-rows{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.ls-rows li{display:grid;grid-template-columns:var(--lab) 1fr var(--hrs);align-items:center;gap:0;min-height:44px;border-radius:10px;transition:background .15s}
.ls-rows li.hit{background:#ffffff0d}.ls-day{font:500 1.5rem var(--fd);letter-spacing:.08em;text-transform:uppercase;padding-left:8px}
.ls-track{position:relative;height:30px;background:var(--night3);border-radius:8px;overflow:hidden;background-image:linear-gradient(90deg,transparent calc(100% - 1px),#ffffff14 0);background-size:calc(100% / 17 * 4) 100%}
.ls-fill{position:absolute;top:0;bottom:0;background:linear-gradient(90deg,var(--red),var(--redhi));border-radius:8px}
.late-night .ls-fill{background:linear-gradient(90deg,var(--red) 0,var(--redhi) 70%,var(--gold))}
.ls-hrs{font-size:.88rem;color:var(--mut);padding-left:12px}.ls-rows li.hit .ls-hrs{color:var(--cream)}
.ls-line{position:absolute;top:30px;bottom:0;left:var(--lab);right:var(--hrs);pointer-events:none}.ls-line b{position:absolute;top:0;bottom:0;width:3px;margin-left:-1.5px;background:var(--cream);border-radius:2px;box-shadow:0 0 14px #fff6}
.nm{position:absolute;top:0;bottom:0;width:0;z-index:2}.nm span{position:absolute;top:50%;translate:-50% -50%;font:700 .68rem/1 var(--fb);background:var(--ok);color:#06210f;padding:3px 6px;border-radius:6px;white-space:nowrap}
.ls-ctl{display:block;margin:22px 0 0}
input[type=range]{width:100%;height:44px;appearance:none;background:transparent;cursor:pointer}
input[type=range]::-webkit-slider-runnable-track{height:8px;border-radius:5px;background:linear-gradient(90deg,var(--red),var(--gold))}
input[type=range]::-moz-range-track{height:8px;border-radius:5px;background:linear-gradient(90deg,var(--red),var(--gold))}
input[type=range]::-webkit-slider-thumb{appearance:none;width:32px;height:32px;margin-top:-12px;border-radius:50%;background:var(--cream);border:4px solid var(--night);box-shadow:0 0 0 2px var(--cream)}
input[type=range]::-moz-range-thumb{width:24px;height:24px;border-radius:50%;background:var(--cream);border:4px solid var(--night);box-shadow:0 0 0 2px var(--cream)}
.ls-btns{display:flex;flex-wrap:wrap;gap:10px;margin:8px 0 14px}.ls-btns button{min-height:44px;padding:0 18px;border-radius:999px;border:1px solid var(--line);background:var(--night);color:var(--cream);font:500 1.15rem var(--fd);letter-spacing:.06em;text-transform:uppercase;cursor:pointer}.ls-btns button:hover{border-color:var(--gold);color:var(--gold)}
@media(max-width:600px){.ls-chart{--lab:44px;--hrs:0px}.ls-hrs{display:none}.ls-rows li{grid-template-columns:var(--lab) 1fr}.ls-day{font-size:1.3rem;padding-left:2px}}
.reel{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x proximity;padding:36px 16px 16px;margin:0 calc(50% - 50vw);width:100vw;-webkit-overflow-scrolling:touch}
.reel figure{margin:0;flex:none;width:min(300px,72vw);scroll-snap-align:center;position:relative}.reel img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:16px;border:1px solid var(--line)}
.reel figcaption{position:absolute;left:10px;bottom:10px;background:#12141Cd9;padding:4px 12px;border-radius:999px;font:500 1.1rem var(--fd);letter-spacing:.06em;text-transform:uppercase}
.reel:focus-visible{outline-offset:-3px}
.menu{background:var(--cream);color:#1a1612}.menu em{color:#B3211F}.menu .kicker{color:#8A5A00}.menu .lede,.menu .fine{color:#4f4840}
.m-bar{display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;margin-top:32px}
.m-tabs{display:flex;gap:8px;overflow-x:auto;max-width:100%;padding-bottom:4px}
.m-tabs button{flex:none;min-height:46px;padding:0 20px;border:2px solid #1a1612;border-radius:999px;background:transparent;color:#1a1612;font:500 1.25rem var(--fd);letter-spacing:.06em;text-transform:uppercase;cursor:pointer}
.m-tabs button[aria-selected=true]{background:#1a1612;color:var(--cream)}.menu a:focus-visible,.menu button:focus-visible,.menu input:focus-visible{outline-color:#B3211F}
.m-q input{min-height:46px;width:min(300px,100%);border:2px solid #1a1612;border-radius:999px;padding:0 18px;font:400 1rem var(--fb);background:#fff;color:#1a1612}
.m-count{min-height:1.5em;margin:12px 0 0;font-weight:700}
.m-panel{margin-top:20px}.m-ph{display:flex;align-items:center;gap:20px;margin-bottom:12px}.m-ph img{width:120px;height:120px;object-fit:cover;border-radius:16px;flex:none}.m-ph h3{font-size:clamp(2.2rem,5vw,3.2rem)}.m-ph p{margin:8px 0 0;color:#4f4840;max-width:56ch}
.m-cols{display:flex;justify-content:flex-end;gap:0;margin:0;padding:8px 0;font:500 1.1rem var(--fd);letter-spacing:.08em;text-transform:uppercase;color:#6a4a00;border-bottom:2px solid #1a1612}.m-cols span{width:92px;text-align:right}
.m-list{list-style:none;margin:0;padding:0}.m-it{display:flex;justify-content:space-between;gap:20px;padding:16px 0;border-bottom:1px solid #d9ccb2}
.m-n b{font-weight:700;font-size:1.08rem}.m-n span{display:block;font-size:.95rem;color:#4f4840;margin-top:2px;max-width:60ch}
.m-p{display:flex;flex:none;align-items:flex-start}.m-p span{width:92px;text-align:right;font-weight:700;font-variant-numeric:tabular-nums}.m-p small{display:none}
@media(max-width:620px){.m-cols{display:none}.m-ph img{width:84px;height:84px}.m-it{flex-direction:column;gap:6px}.m-p{gap:16px;flex-wrap:wrap}.m-p span{width:auto;text-align:left}.m-p small{display:inline;font-weight:400;color:#4f4840;margin-right:5px;font-size:.85rem}}
.m-none{font-weight:700;margin-top:24px}
.story-in{display:grid;grid-template-columns:repeat(12,1fr);gap:16px;align-items:start}
.story-in figure{margin:0;position:relative}.story-in img{width:100%;height:100%;object-fit:cover;border-radius:16px;border:1px solid var(--line)}.story-in figcaption{font-size:.88rem;color:var(--mut);margin-top:8px}
.s-t{grid-column:1/8;grid-row:1}.s-a{grid-column:8/13;grid-row:1}.s-a img{aspect-ratio:1}
.s-b{grid-column:1/7;grid-row:2}.s-b img{aspect-ratio:16/10}.s-c{grid-column:7/10;grid-row:2}.s-c img{aspect-ratio:1}.s-d{grid-column:10/13;grid-row:2}.s-d img{aspect-ratio:1}
.s-e{display:none}
@media(max-width:820px){.s-t,.s-a,.s-b,.s-c,.s-d{grid-column:1/-1;grid-row:auto}.s-c,.s-d{grid-column:span 6}.s-t{order:-1}.story-in{grid-template-columns:repeat(12,1fr)}.s-c{grid-column:1/7}.s-d{grid-column:7/13}}
.visit{background:var(--night2);border-top:1px solid var(--line)}
.visit-in{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,64px);align-items:start}@media(max-width:820px){.visit-in{grid-template-columns:1fr}}
.addr{font-size:1.2rem;margin:20px 0 6px}.tel{font:500 2.6rem var(--fd);letter-spacing:.05em;text-decoration:none;color:var(--gold)}.visit .cta{margin:14px 0 24px}
.sign{margin:0}.sign img{border-radius:16px;border:1px solid var(--line);aspect-ratio:16/9;object-fit:cover;width:100%}
.hours{background:var(--night);border:1px solid var(--line);border-radius:20px;padding:24px}.pl-head{display:flex;align-items:center;gap:10px;margin:0 0 12px;font-weight:700}
.hours table{width:100%;border-collapse:collapse}.hours th,.hours td{text-align:left;padding:12px 0;border-bottom:1px solid var(--line);font-weight:400}.hours th{font:500 1.35rem var(--fd);letter-spacing:.06em;text-transform:uppercase}.hours td{text-align:right}
.hours tr.today th,.hours tr.today td{color:var(--gold);font-weight:700}
.foot{padding:36px 0 40px;border-top:1px solid var(--line)}.foot .wrap{display:flex;align-items:center;gap:18px}.foot img{width:64px;height:64px;border-radius:10px}.foot p{margin:0}.foot a{color:var(--cream)}
.dock{display:none}
@media(max-width:820px){.dock{position:fixed;left:0;right:0;bottom:0;z-index:40;display:grid;grid-template-columns:1fr 1.4fr 1fr;background:var(--night2);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom)}.dock a{display:flex;align-items:center;justify-content:center;min-height:56px;font:500 1.3rem var(--fd);letter-spacing:.07em;text-transform:uppercase;text-decoration:none}.dock .pri{background:var(--red);color:#fff}}
.rv{opacity:1}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
